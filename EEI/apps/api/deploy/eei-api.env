# eei-api（公开数据接口）的拉取式部署配置。装到服务器 /etc/linze-pull-deploy/eei-api.env（deploy/install.sh 会安装）。
# 变量含义见 apps/universe/deploy/eei-universe.env 与 eei-api-pull-deploy.sh 头部；本文件只列与本项目相关的取值。

REPO_URL=https://github.com/LinzeColin/MetaDatabase.git   # 公开仓，匿名 https
BRANCH=main
SUBDIR=EEI                                                # 构建上下文（Dockerfile 要 pyproject.toml / uv.lock，它们在 EEI 根）
DOCKERFILE=apps/api/deploy/Dockerfile                     # 相对 SUBDIR
SPARSE_PATHS="EEI/apps/api EEI/scripts EEI/data"          # 只展开这些目录（部分克隆 + sparse checkout；cone 模式自带父目录下的文件）
# 变化检测指纹：这些路径的 git 哈希合起来。宇宙、旧前端或文档的提交不会触发 eei-api 重建。
TREE_PATHS="EEI/apps/api EEI/scripts/relationship_publication_gate.py EEI/scripts/publish_to_cloud_channel.py EEI/scripts/db_tools.py EEI/data EEI/pyproject.toml EEI/uv.lock"
IMAGE=linze/eei-api
CONTAINER_PORT=8000
HEALTH_PATH=/health
HEALTH_CODE=200
HEALTH_BODY_REGEX='"status": ?"ok"'                        # 库连不上或角色可写时 /health 回 503，不会被放行
NET_ALIAS=eei-api                                         # 宇宙容器用 http://eei-api:8000 访问
DB_CONTAINER=eei-db                                       # 候选容器放进它所在的 docker 网络
STAGING_NETWORK=                                          # 留空 = 自动取 eei-db 所在的用户自定义网络；取不到时写死网络名
DOCKER_NETWORK=coolify                                    # 宇宙容器所在网络（与 eei-universe.env 的 DOCKER_NETWORK 一致）
MEMORY=256m

# 只读根文件系统、非 root、丢全部 capability、不设交换区、限 CPU；不发布任何端口。
# 数据库连接串（eei_reader 只读角色，DATABASE_URL=...）只放服务器 /etc/eei-api/eei-api.secret.env（chmod 600），不进仓库。
RUN_EXTRA_ARGS='--read-only --tmpfs /tmp:rw,noexec,nosuid,size=16m --cap-drop ALL --user 10001 --memory-swap 256m --cpus 0.5 --env-file /etc/eei-api/eei-api.secret.env'
