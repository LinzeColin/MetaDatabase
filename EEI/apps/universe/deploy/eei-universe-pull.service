[Unit]
Description=Pull-based deploy for EEI 商域宇宙 (git fetch -> build -> health check -> switch, keep old on failure)
Documentation=https://github.com/LinzeColin/MetaDatabase/tree/main/EEI/apps/universe/deploy
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/eei-pull-deploy.sh run eei-universe
TimeoutStartSec=25min
Nice=15
IOSchedulingClass=idle
StateDirectory=linze-pull-deploy
# ProtectHome 让 /root 不可写，docker CLI 的配置目录改放到状态目录
Environment=DOCKER_CONFIG=/var/lib/linze-pull-deploy/docker-config
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
