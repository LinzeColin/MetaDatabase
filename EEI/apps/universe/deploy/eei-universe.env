# 商域宇宙的拉取式部署配置。装到服务器 /etc/linze-pull-deploy/eei-universe.env（deploy/install.sh 会安装）。
# 变量含义见 LinzeHomeHub deploy/pull/home-hub.env；本文件只列与本项目相关的取值。

REPO_URL=https://github.com/LinzeColin/MetaDatabase.git   # 公开仓，匿名 https
BRANCH=main
SUBDIR=EEI                                                # Docker 构建上下文（EEI/ 目录；多阶段 Dockerfile 要同时用到 apps/universe、apps/web、data 与 pnpm 锁文件）
DOCKERFILE=apps/universe/deploy/Dockerfile                # 相对 SUBDIR
# 只检出并只监视这些路径（部分克隆 + 非 cone 稀疏检出）：EEI/ 里其它文档的提交不触发重建。改了前端源码、宇宙页面、目录台账、依赖锁才重建。
WATCH_PATHS='EEI/apps/universe EEI/apps/web EEI/data EEI/package.json EEI/pnpm-workspace.yaml EEI/pnpm-lock.yaml'
DOMAIN=eei.linzezhang.com                                 # 正式主域名（2026-09-30 起主站在 VPS-3；旧预览域名 eei-preview 已收掉）
IMAGE=linze-pull/eei-universe
CONTAINER_PORT=8080
HEALTH_PATH=/
HEALTH_CODE=200
HEALTH_BODY_REGEX='商域宇宙'                               # 空白页 / 502 页不会被放行
VERSION_PATH=/version.txt
DOCKER_NETWORK=coolify
STAGING_NETWORK=bridge
CERT_RESOLVER=letsencrypt
MEMORY=112m                                               # 含 /tmp 内存盘里的数据接口缓存（上限 32m）

# 只读根文件系统：可写只有 /tmp 与 /etc/nginx/conf.d（envsubst 渲染站点配置）两块内存盘；丢掉全部 capability。
RUN_EXTRA_ARGS='--read-only --tmpfs /tmp:rw,noexec,nosuid,size=48m --tmpfs /etc/nginx/conf.d:rw,noexec,nosuid,size=1m,uid=101,gid=101,mode=755 --cap-drop ALL'

# 额外域名机制（脚本保留）：EXTRA_DOMAINS 里的域名与 DOMAIN 走同一个容器；EXTRA_DOMAINS_CERT=yes 才为它们向 Let's Encrypt 申请证书
# （域名没指向本机时申请必失败并累计失败次数，所以域名切过来之前保持 no）。目前主站就是 DOMAIN，没有额外域名。
EXTRA_DOMAINS=
EXTRA_DOMAINS_CERT=yes

# 上游 EEI_UPSTREAM 是容器的运行时环境变量，默认值写在 Dockerfile 的 ENV 里（= Cloudflare Workers 上的旧程序，即 workers.dev 地址；现在只剩 /v1/*、/health 和本地找不到的路径走它）；
# 要换上游：在上面 RUN_EXTRA_ARGS 里加 `-e EEI_UPSTREAM=https://新上游`，再 run --force。
