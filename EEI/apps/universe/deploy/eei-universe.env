# 商域宇宙的拉取式部署配置。装到服务器 /etc/linze-pull-deploy/eei-universe.env（deploy/install.sh 会安装）。
# 变量含义见 LinzeHomeHub deploy/pull/home-hub.env；本文件只列与本项目相关的取值。

REPO_URL=https://github.com/LinzeColin/MetaDatabase.git   # 公开仓，匿名 https
BRANCH=main
SUBDIR=EEI/apps/universe                                  # 只取这个目录（部分克隆 + sparse checkout），也是 Docker 构建上下文
DOCKERFILE=deploy/Dockerfile                              # 相对 SUBDIR
DOMAIN=eei-preview.linzezhang.com
IMAGE=linze-pull/eei-universe
CONTAINER_PORT=8080
HEALTH_PATH=/
HEALTH_CODE=200
HEALTH_BODY_REGEX='商域宇宙'                               # 空白页 / 502 页不会被放行
VERSION_PATH=/version.txt
DOCKER_NETWORK=coolify
STAGING_NETWORK=bridge
CERT_RESOLVER=letsencrypt
MEMORY=64m

# 只读根文件系统：可写只有 /tmp 与 /etc/nginx/conf.d（envsubst 渲染站点配置）两块内存盘；丢掉全部 capability。
RUN_EXTRA_ARGS='--read-only --tmpfs /tmp:rw,noexec,nosuid,size=16m --tmpfs /etc/nginx/conf.d:rw,noexec,nosuid,size=1m,uid=101,gid=101,mode=755 --cap-drop ALL'

# 主站预留：同一个容器也接受 eei.linzezhang.com 的路由。域名目前还在 Cloudflare 旧程序上，流量不会到这里；
# 默认不为它申请证书（域名没指向本机时 Let's Encrypt 验证必失败并累计失败次数）。
# 切主站：DNS 指向服务器后，把 EXTRA_DOMAINS_CERT 改 yes，再 `sudo /usr/local/bin/eei-pull-deploy.sh run eei-universe --force`。
EXTRA_DOMAINS=eei.linzezhang.com
EXTRA_DOMAINS_CERT=no

# 上游 EEI_UPSTREAM 是容器的运行时环境变量，默认值写在 Dockerfile 的 ENV 里（预览期 = Cloudflare Workers 上的旧程序）；
# 要换上游：在上面 RUN_EXTRA_ARGS 里加 `-e EEI_UPSTREAM=https://新上游`，再 run --force。
