SIGNAL_LATTICE_ENV=production
SIGNAL_LATTICE_HOST=127.0.0.1
SIGNAL_LATTICE_PORT=8787
SIGNAL_LATTICE_STATE_DIR=/var/lib/signal-lattice
SIGNAL_LATTICE_ARTIFACT_DIR=/var/lib/signal-lattice/artifacts
SIGNAL_LATTICE_WEB_DIR=/opt/signal-lattice/current/web
SIGNAL_LATTICE_DECISION_POLICY=/opt/signal-lattice/current/config/decision_policy.json
# 只有上游 Seal、合法 Point-in-time 数据、量化与风险硬门均通过后才可设为 HUMAN_DECISION_SUPPORT。
SIGNAL_LATTICE_RECOMMENDATION_MODE=HUMAN_DECISION_SUPPORT
SIGNAL_LATTICE_PUBLIC_URL=https://signal-lattice.linzezhang.com
SIGNAL_LATTICE_STATUS_URL=https://status.linzezhang.com
SIGNAL_LATTICE_LEASE_SECONDS=120
SIGNAL_LATTICE_MAX_REQUEST_BYTES=131072
SIGNAL_LATTICE_REQUEST_TIMEOUT_SECONDS=15
SIGNAL_LATTICE_WORKER_ID=worker-1
# 可选：Cloudflare Tunnel token 只能通过 systemd credential 或 /etc/signal-lattice/credentials 注入，禁止写入仓库。
# 模型 API Key、Agent Runtime 配置、券商凭证和 macOS 路径均禁止出现在生产环境。

# 写入型数据接口只接受此文件中的 Bearer Token；部署脚本会自动生成。
SIGNAL_LATTICE_INGEST_TOKEN_FILE=/etc/signal-lattice/credentials/ingest_api_token
