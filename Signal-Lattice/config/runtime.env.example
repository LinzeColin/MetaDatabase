SIGNAL_LATTICE_ENV=production
SIGNAL_LATTICE_HOST=127.0.0.1
SIGNAL_LATTICE_PORT=8787
SIGNAL_LATTICE_STATE_DIR=/var/lib/signal-lattice
SIGNAL_LATTICE_ARTIFACT_DIR=/var/lib/signal-lattice/artifacts
SIGNAL_LATTICE_WEB_DIR=/opt/signal-lattice/current/web
SIGNAL_LATTICE_DECISION_POLICY=/opt/signal-lattice/current/config/decision_policy.json
SIGNAL_LATTICE_UNIVERSE_FILE=/opt/signal-lattice/current/config/universe.json
SIGNAL_LATTICE_RUNTIME_MANIFEST_DIR=/opt/signal-lattice/current/config/runtime_manifests
SIGNAL_LATTICE_RECOMMENDATION_MODE=HUMAN_DECISION_SUPPORT
# 永远只提供人工决策支持；显式禁止任何自动下单或 live action。
SIGNAL_LATTICE_LIVE_ACTION=0
SIGNAL_LATTICE_PUBLIC_URL=https://signal-lattice.linzezhang.com
SIGNAL_LATTICE_STATUS_URL=https://status.linzezhang.com
SIGNAL_LATTICE_CYCLE_INTERVAL_SECONDS=60
SIGNAL_LATTICE_CYCLE_DEADLINE_SECONDS=55
SIGNAL_LATTICE_SKILL_TIMEOUT_SECONDS=8
SIGNAL_LATTICE_SKILL_MEMORY_MB=256
SIGNAL_LATTICE_MINIMUM_ACTIVE_SKILLS=5
SIGNAL_LATTICE_MINIMUM_COMPLETED_SKILLS=3
SIGNAL_LATTICE_MARKET_PROVIDER=moomoo
SIGNAL_LATTICE_MARKET_LICENSE_CONFIRMED=0
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
SIGNAL_LATTICE_ISOLATION_BACKEND=subprocess_guard
SIGNAL_LATTICE_UPSTREAM_REPO=https://github.com/LinzeColin/MetaDatabase.git
SIGNAL_LATTICE_UPSTREAM_BRANCH=main
SIGNAL_LATTICE_UPSTREAM_SPARSE_PATH=Signal-Lattice/Stock_Skill
SIGNAL_LATTICE_UPSTREAM_CHECKOUT_DIR=/var/lib/signal-lattice/upstream/MetaDatabase
SIGNAL_LATTICE_INGEST_TOKEN_FILE=/etc/signal-lattice/credentials/ingest_api_token
# 严禁：OPENAI_API_KEY、ANTHROPIC_API_KEY、GEMINI_API_KEY、任何 Agent Runtime、交易权限或 macOS 路径。
