{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-lattice.local/schemas/frozen_replay.schema.json",
  "title": "Signal Lattice 冻结重放收据",
  "type": "object",
  "required": ["schema_version", "state", "subject_sha256", "gate_fingerprint", "checks", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "state": {"enum": ["PASS", "BLOCKED", "FAIL"]},
    "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "array"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
