{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-lattice.local/schemas/stop_and_freeze.schema.json",
  "title": "Signal Lattice STOP_AND_FREEZE 收据",
  "type": "object",
  "required": [
    "schema_version", "state", "subject_sha256", "qualifying_round_count",
    "open_p0", "open_p1", "frozen_replays_identical", "decision", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "state": {"enum": ["PASS", "BLOCKED", "FAIL"]},
    "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualifying_round_count": {"type": "integer", "minimum": 0},
    "open_p0": {"type": "integer", "minimum": 0},
    "open_p1": {"type": "integer", "minimum": 0},
    "frozen_replays_identical": {"type": "boolean"},
    "decision": {"enum": ["STOP_AND_FREEZE", "CONTINUE_REMEDIATION"]},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
