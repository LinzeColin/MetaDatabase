{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-lattice.local/schemas/task_execution_contract.schema.json",
  "title": "Signal Lattice 冻结任务执行合同",
  "type": "object",
  "required": ["schema_version", "version", "tasks"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "version": {"type": "string", "pattern": "^0\\.0\\.0\\.1\\.[0-9]+$"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id", "title", "mode", "environment_bound", "environment_bound_reason",
          "authorization_required", "authorization_env", "required_env", "commands",
          "timeout_seconds", "allow_degraded", "expected", "failure_branch",
          "stop_condition", "rollback", "evidence_path"
        ],
        "properties": {
          "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "mode": {"enum": ["DETERMINISTIC", "ENVIRONMENT_BOUND", "AUTHORIZED_SIDE_EFFECT"]},
          "environment_bound": {"type": "boolean"},
          "environment_bound_reason": {"type": ["string", "null"]},
          "authorization_required": {"type": "boolean"},
          "authorization_env": {"type": ["string", "null"]},
          "required_env": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "uniqueItems": true},
          "commands": {
            "type": "array", "minItems": 1,
            "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
          "allow_degraded": {"type": "boolean"},
          "expected": {"type": "string", "minLength": 1},
          "failure_branch": {"type": "string", "minLength": 1},
          "stop_condition": {"type": "string", "minLength": 1},
          "rollback": {"type": "string", "minLength": 1},
          "evidence_path": {"type": "string", "pattern": "^\\{ARTIFACT_DIR\\}/tasks/T-[0-9]{3}\\.json$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
