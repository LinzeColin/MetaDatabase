{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-lattice.local/schemas/state_transition.schema.json",
  "title": "Signal Lattice 状态转换收据",
  "type": "object",
  "required": ["schema_version", "state", "version", "from_phase", "to_phase", "subject_sha256", "canonical_state_before_sha256", "canonical_state_after_sha256", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "state": {"const": "PASS"},
    "version": {"type": "string"},
    "from_phase": {"type": "string"},
    "to_phase": {"type": "string"},
    "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_state_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_state_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
