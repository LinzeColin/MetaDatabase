{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-lattice.local/schemas/owner_approval.schema.json",
  "title": "Signal Lattice Owner 阶段二批准",
  "type": "object",
  "required": ["schema_version", "approved", "version", "subject_sha256", "scope_summary_sha256", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "approved": {"const": true},
    "version": {"type": "string", "pattern": "^0\\.0\\.0\\.1\\.[0-9]+$"},
    "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
