[Unit]
Description=Signal Lattice V2 monthly hub backtest (proof-gate evidence)
After=network-online.target
Wants=network-online.target
OnFailure=signal-lattice-v2-research-failed.service

[Service]
Type=oneshot
User=signal-lattice
Group=signal-lattice
EnvironmentFile=/etc/signal-lattice-v2/runtime.env
ExecStart=/bin/bash -c 'exec /opt/signal-lattice-v2/current/venv/bin/signal-lattice backtest --research-dir /var/lib/signal-lattice-v2/research/out --out-dir /var/lib/signal-lattice-v2/backtest --cache-dir /var/lib/signal-lattice-v2/research/backtest-cache --workers 2 --end "$$(date -d "$$(date +%%Y-%%m-01) -1 day" +%%F)"'
TimeoutStartSec=90min
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
ReadWritePaths=/var/lib/signal-lattice-v2
ReadOnlyPaths=/opt/signal-lattice-v2
MemoryMax=2G
CPUQuota=150%
TasksMax=256
