[Unit]
Description=Signal Lattice Status Tier-0 publication
[Service]
Type=oneshot
User=signal-lattice
Group=signal-lattice
EnvironmentFile=/etc/signal-lattice/runtime.env
ExecStart=/opt/signal-lattice/current/venv/bin/python /opt/signal-lattice/current/scripts/status_publish_once.py
TimeoutStartSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
ReadWritePaths=/var/lib/signal-lattice
ReadOnlyPaths=/opt/signal-lattice/current
MemoryMax=256M
