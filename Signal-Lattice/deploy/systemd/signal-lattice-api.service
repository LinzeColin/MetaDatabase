[Unit]
Description=Signal Lattice API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=signal-lattice
Group=signal-lattice
EnvironmentFile=/etc/signal-lattice/runtime.env
ExecStart=/opt/signal-lattice/current/venv/bin/signal-lattice serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/signal-lattice
ReadOnlyPaths=/opt/signal-lattice/current
MemoryMax=512M
CPUQuota=100%
TasksMax=64

[Install]
WantedBy=multi-user.target
