[Unit]
Description=Signal Lattice SQLite backup
[Service]
Type=oneshot
User=signal-lattice
Group=signal-lattice
EnvironmentFile=/etc/signal-lattice/runtime.env
ExecStart=/opt/signal-lattice/current/venv/bin/signal-lattice backup /var/lib/signal-lattice/backups/runtime-latest.db
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
ReadWritePaths=/var/lib/signal-lattice
ReadOnlyPaths=/opt/signal-lattice/current
MemoryMax=256M
