+
+URL = "https://adp.linzezhang.com/"
+html = subprocess.run(["curl", "-s", "--max-time", "25", URL], capture_output=True, text=True).stdout
+checks = {}
+for t in ("warm", "minimal", "fresh", "techno", "cosmos", "forest"):
