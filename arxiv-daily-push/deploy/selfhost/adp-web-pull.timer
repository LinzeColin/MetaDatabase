[Unit]
Description=Poll ADP (MetaDatabase main) every 10 minutes (pull-based deploy)
Documentation=https://github.com/LinzeColin/MetaDatabase/tree/main/arxiv-daily-push/deploy/selfhost

[Timer]
OnBootSec=150s
OnCalendar=*:5/10
RandomizedDelaySec=30s
AccuracySec=10s

[Install]
WantedBy=timers.target
