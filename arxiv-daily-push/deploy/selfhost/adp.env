# ADP 自托管的拉取式部署配置。装到服务器 /etc/linze-pull-deploy/adp.env（install.sh 会安装）。
# 变量含义见 LinzeHomeHub deploy/pull/home-hub.env 与 EEI/apps/universe/deploy/eei-universe.env；本文件只列取值。
# 文件里只有公开信息：没有密钥、令牌、账号。ADP 运行时不需要任何凭据。

REPO_URL=https://github.com/LinzeColin/MetaDatabase.git   # 公开仓，匿名 https
BRANCH=main
SUBDIR=arxiv-daily-push/deploy                            # 只取这个目录（部分克隆 + sparse checkout），也是 Docker 构建上下文；ADP 文档/治理提交不会触发重建
DOCKERFILE=selfhost/Dockerfile                            # 相对 SUBDIR
DOMAIN=adp.linzezhang.com                                 # 正式域名（DNS 由主线切到 VPS-3 之后才有真实流量；切之前路由已就位）
IMAGE=linze-pull/adp
CONTAINER_PORT=8080
HEALTH_PATH=/healthz                                      # 进程 + 库能读；响应体固定，供「直连 vs 经 Traefik 逐字节一致」回测
HEALTH_CODE=200
HEALTH_BODY_REGEX='"service":"adp"'                       # 502 页 / 空白页不会被放行
VERSION_PATH=/version.txt                                 # 构建时写入的提交号，部署器回测时要求它等于刚部署的提交
DOCKER_NETWORK=coolify
STAGING_NETWORK=bridge
CERT_RESOLVER=letsencrypt
MEMORY=256m                                               # 内存上限（硬要求）
PULL_UNIT=adp-web-pull                                    # 本部署器的 systemd 定时器名（status 与漂移检查用）
SELF_DIR_IN_REPO=arxiv-daily-push/deploy/selfhost
REQUIRE_DIR=/var/lib/adp                                  # 数据目录必须先由 install.sh 建好（属主 10001）

# 域名还没切到本机时 Let's Encrypt 签不出证书，Traefik 暂用自带默认证书；回测走的是 127.0.0.1 回环，只验证路由与内容，
# 不验证证书，所以允许 -k。这样「先部署、后切 DNS」与「先切 DNS」两种顺序都能过回测。
POSTCHECK_INSECURE=1

# 只读根文件系统：可写只有 /tmp（内存盘）与 /data（宿主机 /var/lib/adp，SQLite 库、备份、任务日志）；
# 非 root（10001）、丢掉全部 capability、1 个 CPU；数据目录是唯一的持久状态。
RUN_EXTRA_ARGS='--read-only --tmpfs /tmp:rw,noexec,nosuid,size=32m --cap-drop ALL --cpus 1 --user 10001:10001 -v /var/lib/adp:/data'

# 额外域名机制（脚本保留）：目前没有额外域名。
EXTRA_DOMAINS=
EXTRA_DOMAINS_CERT=yes

# ---- 以下只给每日任务用（adp-daily-run.sh 会 source 本文件；拉取式部署器不认识这些变量，忽略即可）----
ADP_DATA_HOST_DIR=/var/lib/adp
ADP_RETRY_BACKOFF_SECONDS=600,1200                        # 任务级重试的退避：失败后等 10 分钟、再失败等 20 分钟；最多 3 次尝试
ADP_JOB_TIMEOUT_SECONDS=9000                              # 单次任务（含重试）容器内硬上限 2.5 小时；systemd 还有 3 小时总上限
