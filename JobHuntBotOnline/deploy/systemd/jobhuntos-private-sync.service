[Unit]
Description=JobHuntBot Online structured fact sync
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__RUN_USER__
Group=__RUN_GROUP__
Environment=HOME=__RUN_HOME__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/ops/sync_private_database.sh
Nice=10
