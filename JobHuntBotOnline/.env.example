COMPOSE_PROJECT_NAME=jobhuntbot-online
APP_IMAGE=jobhuntbot-online:0.3.0
ACCEPTANCE_IMAGE=jobhuntbot-online-acceptance:0.3.0
APP_ENV=production
APP_NAME=JobHuntBot Online
APP_VERSION=0.3.0
BASE_URL=https://jobhunt.linzezhang.com
DOMAIN=jobhunt.linzezhang.com
APP_TIMEZONE=Australia/Sydney
DATABASE_URL=postgresql+psycopg://jobhunt:CHANGE_ME@postgres:5432/jobhunt
SESSION_SECRET=GENERATE_AT_DEPLOYMENT
DATA_ENCRYPTION_KEY=GENERATE_AT_DEPLOYMENT
EMAIL_LOOKUP_SECRET=GENERATE_AT_DEPLOYMENT
COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=604800
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=GENERATE_AT_DEPLOYMENT
ALLOW_REGISTRATION=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=JobHuntBot <no-reply@example.com>
SMTP_STARTTLS=true

# Platform-owned DeepSeek credential. Never expose this to end users.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_DAILY_PLATFORM_REQUEST_LIMIT=1000
DEEPSEEK_DAILY_PLATFORM_TOKEN_LIMIT=5000000
DEEPSEEK_DEFAULT_USER_REQUEST_LIMIT=60
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=60
DEEPSEEK_CIRCUIT_BREAKER_FAILURES=3
DEEPSEEK_CIRCUIT_BREAKER_MINUTES=15

# Frozen product contract: every completed discovery run schedules the next run exactly 6 hours later.
DISCOVERY_REFRESH_HOURS=6
DISCOVERY_SOURCE_TIMEOUT_SECONDS=15
DISCOVERY_MAX_JOBS_PER_SOURCE=120
DISCOVERY_FIXTURE_PATH=
ENABLE_REMOTIVE=true
ENABLE_ARBEITNOW=true
ENABLE_JOBICY=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ASHBY_BOARDS=
FREEHIRE_BASE_URL=

UPLOAD_ROOT=/data/uploads
BACKUP_ROOT=/data/backups
MAX_UPLOAD_BYTES=10485760
BACKUP_ENCRYPTION_PASSPHRASE=GENERATE_AT_DEPLOYMENT
EDGE_NETWORK=coolify

# Optional one-time v0.2 -> v0.3 migration inputs. Remove after migration.
V02_SQLITE_PATH=
V02_DATA_ROOT=
OLD_DATA_ENCRYPTION_KEY=
V02_PLATFORM_KEY_OUTPUT=

# Real production browser/email acceptance. Use a dedicated mailbox and remove after PASS.
ACCEPTANCE_EMAIL=
ACCEPTANCE_EMAIL_A=
ACCEPTANCE_EMAIL_B=
ACCEPTANCE_EMAIL_PLUS_ALIAS=true
ACCEPTANCE_ACCOUNT_PASSWORD=GENERATE_FOR_ACCEPTANCE
ACCEPTANCE_IMAP_HOST=
ACCEPTANCE_IMAP_PORT=993
ACCEPTANCE_IMAP_USERNAME=
ACCEPTANCE_IMAP_PASSWORD=
ACCEPTANCE_IMAP_FOLDER=INBOX
ACCEPTANCE_IMAP_SSL=true
ACCEPTANCE_IMAP_STARTTLS=false
ACCEPTANCE_MAIL_TIMEOUT_SECONDS=240
ACCEPTANCE_DISCOVERY_TIMEOUT_SECONDS=300
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Optional operations integration. These are evidence/projection paths, not a second business authority.
STATUS_URL=https://status.linzezhang.com
STATUS_REGISTRATION_EVIDENCE=
PRIVATE_DATABASE_SYNC_EVIDENCE=
R2_SYNC_EVIDENCE=
