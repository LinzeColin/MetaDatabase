COMPOSE_PROJECT_NAME=jobhuntbot-online
APP_IMAGE=jobhuntbot-online:0.4.0
ACCEPTANCE_IMAGE=jobhuntbot-online-acceptance:0.4.0
APP_ENV=production
APP_NAME=JobHuntBot Online
APP_VERSION=0.4.0
BASE_URL=https://jobhunt.linzezhang.com
DOMAIN=jobhunt.linzezhang.com
APP_TIMEZONE=Australia/Sydney
# Use the Compose-private alias, not the generic `postgres` name: the web
# service also joins the shared edge network where that generic name can exist.
DATABASE_URL=postgresql+psycopg://jobhunt:CHANGE_ME@jobhuntbot-db:5432/jobhunt
SESSION_SECRET=GENERATE_AT_DEPLOYMENT
DATA_ENCRYPTION_KEY=GENERATE_AT_DEPLOYMENT
EMAIL_LOOKUP_SECRET=GENERATE_AT_DEPLOYMENT
COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=604800
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=GENERATE_AT_DEPLOYMENT
ALLOW_REGISTRATION=false
# A server-controlled, password-protected Owner-only entry used to walk the
# core upload-to-recommendation flow before real email acceptance. It is not a
# registration bypass for ordinary users.
OWNER_ENTRY_ENABLED=false
OWNER_ENTRY_PASSWORD=

# Provider-neutral transactional mail. NitroSend is not used or required.
# Keep registration false until any standard SMTP relay is configured and verified.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=JobHuntBot <no-reply@example.com>
SMTP_STARTTLS=true
# Recipient-level protection across registration, resend and password-reset
# routes. Production validation will not permit a shorter cooldown or a higher
# daily cap than these safe defaults.
EMAIL_MIN_INTERVAL_SECONDS=1800
EMAIL_MAX_PER_USER_PER_24H=3

# Platform-owned DeepSeek credential. Never expose this to end users.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_DAILY_PLATFORM_REQUEST_LIMIT=1000
DEEPSEEK_DAILY_PLATFORM_TOKEN_LIMIT=5000000
DEEPSEEK_DEFAULT_USER_REQUEST_LIMIT=60
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=60
DEEPSEEK_CIRCUIT_BREAKER_FAILURES=3
DEEPSEEK_CIRCUIT_BREAKER_MINUTES=15

# Frozen product contract: every completed discovery run schedules the next run exactly 6 hours later.
DISCOVERY_REFRESH_HOURS=6
DISCOVERY_SOURCE_TIMEOUT_SECONDS=15
DISCOVERY_MAX_JOBS_PER_SOURCE=120
DISCOVERY_FIXTURE_PATH=
ENABLE_REMOTIVE=true
ENABLE_ARBEITNOW=true
ENABLE_JOBICY=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ASHBY_BOARDS=
FREEHIRE_BASE_URL=

UPLOAD_ROOT=/data/uploads
BACKUP_ROOT=/data/backups
MAX_UPLOAD_BYTES=10485760
BACKUP_ENCRYPTION_PASSPHRASE=GENERATE_AT_DEPLOYMENT
EDGE_NETWORK=coolify

# Optional one-time v0.2 -> v0.3 migration inputs. `V02_SQLITE_PATH` must be
# an isolated restore of the fresh T01 encrypted backup, never a live WAL-mode SQLite file.
# Remove these inputs after migration and recovery verification.
V02_SQLITE_PATH=
V02_DATA_ROOT=
OLD_DATA_ENCRYPTION_KEY=
V02_PLATFORM_KEY_OUTPUT=

# Optional one-time v0.2 traffic fallback. Keep blank for normal v0.3 upgrades.
LEGACY_COMPOSE_FILE=
LEGACY_SERVICE=app

# Real production browser/email acceptance. Configure two distinct dedicated
# acceptance addresses explicitly. A single designated IMAP inbox may receive
# both addresses (such as two plus aliases) only with the explicit setting
# below; it never relaxes the three-message, 30-minute, 24-hour safeguards.
ACCEPTANCE_EMAIL_A=
ACCEPTANCE_EMAIL_B=
ACCEPTANCE_ALLOW_SHARED_IMAP_INBOX=false
ACCEPTANCE_ACCOUNT_PASSWORD=GENERATE_FOR_ACCEPTANCE
# A real run requires this explicit opt-in and a fresh non-sensitive run ID.
# The harness consumes each run ID once, reserves at most three messages, waits
# at least 30 minutes between requests, and refuses another run for 24 hours.
RUN_REAL_EMAIL_ACCEPTANCE=false
REAL_EMAIL_ACCEPTANCE_RUN_ID=
ACCEPTANCE_MIN_EMAIL_GAP_SECONDS=1800
ACCEPTANCE_EMAIL_REQUEST_SAFETY_SECONDS=30
ACCEPTANCE_REAL_EMAIL_COOLDOWN_HOURS=24
ACCEPTANCE_IMAP_HOST=
ACCEPTANCE_IMAP_PORT=993
ACCEPTANCE_IMAP_CONNECT_TIMEOUT_SECONDS=20
ACCEPTANCE_IMAP_USERNAME=
ACCEPTANCE_IMAP_PASSWORD=
ACCEPTANCE_IMAP_FOLDER=INBOX
ACCEPTANCE_IMAP_SSL=true
ACCEPTANCE_IMAP_STARTTLS=false
ACCEPTANCE_MAIL_TIMEOUT_SECONDS=240
ACCEPTANCE_DISCOVERY_TIMEOUT_SECONDS=300
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Optional operations integration. These are evidence/projection paths, not a second business authority.
STATUS_URL=https://status.linzezhang.com
STATUS_REGISTRATION_EVIDENCE=
PRIVATE_DATABASE_SYNC_EVIDENCE=
R2_SYNC_EVIDENCE=
