{
  "version": "0.4.0",
  "tasks": [
    {
      "id": "T00",
      "title": "观察当前真实功能和仓库",
      "depends_on": [],
      "action": "只读观察最新仓库、真实网站、数据库、调度、邮件、人工智能服务、已有测试和第一处功能断点。",
      "outputs": [
        "evidence/target-current-truth.json"
      ],
      "acceptance": [
        "AC-PACK-00"
      ],
      "rollback": "只读",
      "stop_condition": "目标项目或真实入口无法确定"
    },
    {
      "id": "T01",
      "title": "保护当前可用版本",
      "depends_on": [
        "T00"
      ],
      "action": "创建应用、数据库、上传对象和配置恢复点，记录当前可执行回滚目标。",
      "outputs": [
        "runtime-data/predeploy-backup.txt",
        "runtime-data/rollback-image.txt"
      ],
      "acceptance": [
        "AC-RECOVERY-13"
      ],
      "rollback": "保持当前版本运行",
      "stop_condition": "备份不可读或无恢复权限"
    },
    {
      "id": "T02",
      "title": "良性合入 v0.4 增量",
      "depends_on": [
        "T00",
        "T01"
      ],
      "action": "按语义比较当前实现与本包，只合入金融／法律资格、多简历路由、DOCX 和中文体验；保护所有更优现有实现。",
      "outputs": [
        "当前仓可运行 Candidate"
      ],
      "acceptance": [
        "AC-FINANCE-02",
        "AC-LEGAL-03",
        "AC-RESUME-04",
        "AC-DOCX-05",
        "AC-CHINESE-08"
      ],
      "rollback": "独立工作树或可逆提交",
      "stop_condition": "发现改变北极星、数据权威、费用或法律边界"
    },
    {
      "id": "T03",
      "title": "运行源码与数据事务测试",
      "depends_on": [
        "T02"
      ],
      "action": "运行完整测试、编译、界面合同和真实 Uvicorn 金融／法律双用户事务；修复第一处断点并重跑。",
      "outputs": [
        "evidence/target-source-tests-v04.json",
        "evidence/target-http-v04.json"
      ],
      "acceptance": [
        "AC-FINANCE-02",
        "AC-LEGAL-03",
        "AC-RESUME-04",
        "AC-DOCX-05",
        "AC-TENANT-10",
        "AC-PERSIST-12"
      ],
      "rollback": "回退本次失败改动",
      "stop_condition": "同类修复两次仍失败"
    },
    {
      "id": "T04",
      "title": "适配数据库和部署运行时",
      "depends_on": [
        "T01",
        "T03"
      ],
      "action": "执行必要的向前兼容迁移，部署 Web、调度器和后台任务处理器；不因暂缺 SMTP 停止非邮件工作。",
      "outputs": [
        "migration-result.json",
        "当前部署"
      ],
      "acceptance": [
        "AC-DISCOVERY-06",
        "AC-REFRESH-07",
        "AC-PERSIST-12"
      ],
      "rollback": "恢复应用和数据库恢复点",
      "stop_condition": "迁移数量或读回不一致"
    },
    {
      "id": "T05",
      "title": "真实浏览器逐控件验收",
      "depends_on": [
        "T04"
      ],
      "action": "在允许 Chromium 的环境使用金融／法律合成账户，逐页操作所有可见按钮、输入、筛选、链接和下载，核对页面、网络、数据库与控制台。",
      "outputs": [
        "evidence/target-browser-v04.json"
      ],
      "acceptance": [
        "AC-AUTH-01",
        "AC-CONTROLS-09",
        "AC-CHINESE-08",
        "AC-TENANT-10",
        "AC-DOCX-05"
      ],
      "rollback": "删除合成账户和测试数据",
      "stop_condition": "浏览器、账户、邮件或权限不可用时仅标记受影响项并继续其他验证"
    },
    {
      "id": "T06",
      "title": "验证真实来源、六小时刷新和人工智能降级",
      "depends_on": [
        "T04"
      ],
      "action": "核对授权岗位来源、新增／更新／去重／失败状态、下一次六小时调度和平台人工智能成功／失败降级。",
      "outputs": [
        "evidence/target-sources.json",
        "evidence/target-state-after.json",
        "evidence/target-deepseek.json"
      ],
      "acceptance": [
        "AC-DISCOVERY-06",
        "AC-REFRESH-07",
        "AC-AI-11"
      ],
      "rollback": "恢复旧配置或停用失败来源",
      "stop_condition": "新增费用或未授权来源"
    },
    {
      "id": "T07",
      "title": "重启读回和恢复验证",
      "depends_on": [
        "T05",
        "T06"
      ],
      "action": "重启应用运行时，核对推荐、简历、申请包和状态；验证备份可读和隔离恢复。",
      "outputs": [
        "evidence/target-restart.json",
        "evidence/target-recovery.json"
      ],
      "acceptance": [
        "AC-PERSIST-12",
        "AC-RECOVERY-13"
      ],
      "rollback": "执行既有回滚路径",
      "stop_condition": "读回或恢复不一致"
    },
    {
      "id": "T08",
      "title": "最终功能裁决",
      "depends_on": [
        "T03",
        "T05",
        "T06",
        "T07"
      ],
      "action": "基于真实用户结果生成 ACCEPTANCE_RESULT.json；提交／部署身份仅作记录，不代替功能结论。",
      "outputs": [
        "ACCEPTANCE_RESULT.json"
      ],
      "acceptance": [
        "AC-PACK-00",
        "AC-AUTH-01",
        "AC-FINANCE-02",
        "AC-LEGAL-03",
        "AC-RESUME-04",
        "AC-DOCX-05",
        "AC-DISCOVERY-06",
        "AC-REFRESH-07",
        "AC-CHINESE-08",
        "AC-CONTROLS-09",
        "AC-TENANT-10",
        "AC-AI-11",
        "AC-PERSIST-12",
        "AC-RECOVERY-13"
      ],
      "rollback": "失败则恢复最后验证版本",
      "stop_condition": "任何关键验收未通过或存在 P0/P1"
    },
    {
      "id": "T09",
      "title": "落库、部署和交接",
      "depends_on": [
        "T08"
      ],
      "action": "按目标仓当前治理 commit、push，并在已授权范围完成 PR／合并／部署；回报可点击入口、实际用户结果和回滚目标。",
      "outputs": [
        "当前仓提交",
        "部署结果",
        "简明交接"
      ],
      "acceptance": [
        "AC-PACK-00",
        "AC-PERSIST-12",
        "AC-RECOVERY-13"
      ],
      "rollback": "回滚应用并保留修复分支",
      "stop_condition": "需要 Owner 的公开发布、费用、法律或不可逆决定"
    }
  ]
}
