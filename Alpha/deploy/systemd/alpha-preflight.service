# 盘前自检 / 死人开关(oneshot,alpha-preflight.timer 驱动)。只读探针,无激活权限,永不下单。
[Unit]
Description=Alpha 盘前自检(OpenD会话/授权/心跳/刹车;全绿即死人开关信号)
After=network-online.target postgresql.service alpha-opend.service
OnFailure=alpha-alert@%n.service

[Service]
Type=oneshot
User=alpha
Group=alpha
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/alpha/MetaDatabase/Alpha
EnvironmentFile=/opt/alpha/env
ExecStart=/opt/alpha/venv/bin/python scripts/preflight_check.py
TimeoutStartSec=180
