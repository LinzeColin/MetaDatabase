# /opt/alpha/env —— OVH VPS-3 影子盘(SHADOW)环境文件模板(权限 root:root 600)
# 红线:本模板进 Git,填了真值的文件永不进 Git;仓库是公开的,收件地址等也只放占位。
# install.sh 只在 /opt/alpha/env 不存在时才用本模板生成,并自动填好端口与控制页令牌;
# 其余标 <REQUIRED_...> 的项由部署方手填,填完再跑一次 install.sh 才会启用服务。
#
# systemd EnvironmentFile 语法:注释只能独占一行(行首 #);
# 绝不可在 KEY=VALUE 行尾加行内注释——systemd 会把 " # ..." 当成值的一部分。
#
# 模式只从本文件读取;alpha 用户读不到也写不了它,所以系统无法自己升级模式。
# 升级到券商模拟盘 / 微实盘只能由 owner 手动改这里并另行签字。
# 升级必须同时换全新的 ALPHA_DATABASE_URL 与 ALPHA_RUNTIME_DIR:账本与运行目录带模式戳,
# 影子盘的模拟成交绝不能被券商模式当成真实持仓沿用;戳与模式不符时交易进程拒绝装配。
# 旧账本与旧运行目录原地留档,不删不改。
# 本文件不含也不许含:券商账户号、券商登录/解锁口令、OPEND_*、本金/汇率覆盖键、IMAP 收信配置。

# ---- 模式(缺失或拼错一律按未启用处理,不会缺省成模拟盘) ----
ALPHA_MODE=SHADOW
LIVE_TRADING_ENABLED=0

# ---- 数据(全部在 /var/lib/alpha,再次部署不触碰) ----
ALPHA_DATABASE_URL=sqlite:////var/lib/alpha/alpha.sqlite
ALPHA_RUNTIME_DIR=/var/lib/alpha
ALPHA_KILL_SWITCH_PATH=/var/lib/alpha/KILL_SWITCH
ALPHA_BACKUP_DIR=/var/lib/alpha/backups
ALPHA_BACKUP_KEEP=14

# ---- 策略 ----
ALPHA_STRATEGY_CONFIG=configs/strategies/s1_gem_plus.yaml

# ---- 控制页(只绑回环;公网入口走 Cloudflare Tunnel,路由在 Cloudflare 侧配置) ----
ALPHA_CONTROL_BIND=127.0.0.1:<REQUIRED_PORT>
ALPHA_CONTROL_TOKEN=<REQUIRED_RANDOM_TOKEN_64>

# ---- 邮件(经本机邮件中继容器 linze-smtp-bridge;地址端口部署时填) ----
ALPHA_SMTP_HOST=<REQUIRED_SMTP_RELAY_HOST>
ALPHA_SMTP_PORT=<REQUIRED_SMTP_RELAY_PORT>
ALPHA_SMTP_STARTTLS=0
ALPHA_SMTP_FROM=<REQUIRED_FROM_ADDRESS>
ALPHA_NOTIFY_RECIPIENT=<REQUIRED_RECIPIENT>

# ---- 守护 ----
ALPHA_SUPERVISOR_SUDO_RESTART=0

# ---- 第二通道(可空) ----
ALPHA_ALERT_WEBHOOK=
