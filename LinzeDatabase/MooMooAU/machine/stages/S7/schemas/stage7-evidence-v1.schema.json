{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MooMooAU Stage 7 Preparation Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "stage_id",
    "task_id",
    "stage_acceptance_id",
    "observed_at_utc",
    "baseline_commit",
    "record_status",
    "scope",
    "delivery_status",
    "checks",
    "linked_final_acceptance",
    "production_oracles",
    "blockers",
    "prohibition_counters",
    "next_action"
  ],
  "properties": {
    "schema_version": {"const": "moomooau.stage7-evidence.v1"},
    "evidence_id": {"type": "string", "pattern": "^S7-T070[1-8]-[A-Z0-9_-]+$"},
    "stage_id": {"const": "S7"},
    "task_id": {"pattern": "^T070[1-8]$"},
    "stage_acceptance_id": {"pattern": "^S7AC-00[1-8]$"},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "baseline_commit": {
      "enum": [
        "be8e196b03dcc475ed6261fbe20593b08bd26bcf",
        "eb7ad073ecd7e4e6d0d8b5d39126cc95d3d2427f",
        "e38cd60ed0458cc6ebe7723c26190d17db0bc5f0",
        "cc7c8af9a40122a61ee2549fb365df813cbd4f16",
        "4c207ad539754166fae6642ff4e6850438d3e2fc",
        "64d88e910ab4078bf90e9fa4f7ce01ef87cf02b4",
        "d10f5086e90aa06f4e6373cb0e44111e1f2c36c7",
        "2133673b335a384657c8668b62a1c13055c212cd",
        "8b6faaf9059661edc3153352b8787ddbc4f733f3",
        "6f82e738611e0d2eeeadd2507f738c9e269c91e0",
        "26949ab5031a21b0c515c282c9ef06ff9417e058",
        "9c79b92bcdf8b027727963dfe52bd183a170954c",
        "27886f54a30a12ca7992a908e97340d1d8234430",
        "c2c057b449fe1cbbd470867c274833242e3f139d"
      ]
    },
    "record_status": {"enum": ["READY", "BLOCKED"]},
    "scope": {
      "enum": [
        "LOCAL_SYNTHETIC_PREFLIGHT",
        "LOCAL_SYNTHETIC_AND_PROTECTED_ENTRYPOINT_PREFLIGHT",
        "PROTECTED_FAILED_ATTEMPT_AND_LOCAL_REDIRECT_REPAIR_PREFLIGHT",
        "PROTECTED_FAILED_ATTEMPT_AND_LOCAL_SAFE_DEFERRED_REPAIR_PREFLIGHT",
        "PROTECTED_TWO_FAILED_ATTEMPTS_AND_LOCAL_METADATA_QUARANTINE_REPAIR_PREFLIGHT",
        "PROTECTED_THREE_FAILED_ATTEMPTS_AND_LOCAL_LABEL_REPLAY_REPAIR_PREFLIGHT",
        "PROTECTED_FOUR_FAILED_ATTEMPTS_AND_LOCAL_CLOSED_PHASE_DIAGNOSTIC_PREFLIGHT",
        "PROTECTED_FIVE_FAILED_ATTEMPTS_AND_LOCAL_PROCESSED_PLAN_DIAGNOSTIC_PREFLIGHT",
        "PROTECTED_SIX_FAILED_ATTEMPTS_AND_LOCAL_FIRST_IMPORT_DIAGNOSTIC_PREFLIGHT",
        "PROTECTED_SEVEN_FAILED_ATTEMPTS_AND_LOCAL_POINTER_BLOB_RECOVERY_REPAIR_PREFLIGHT",
        "PROTECTED_EIGHT_FAILED_ATTEMPTS_AND_APP_SCOPE_ACTIVATION_RECOVERY_PREFLIGHT",
        "PROTECTED_NINE_FAILED_ATTEMPTS_AND_CANONICAL_GIT_BLOB_RECOVERY_PREFLIGHT",
        "PROTECTED_NINE_FAILED_ATTEMPTS_ONE_PRE_SECRET_PREFLIGHT_FAILURE_AND_FORMAT_ONLY_CANONICAL_GIT_BLOB_RECOVERY_PREFLIGHT",
        "PROTECTED_NINE_FAILED_ATTEMPTS_TWO_PRE_SECRET_FAILURES_AND_REPOSITORY_SCOPED_AUTHORITY_RECOVERY_PREFLIGHT",
        "PROTECTED_TEN_FAILED_ATTEMPTS_TWO_PRE_SECRET_FAILURES_AND_DETERMINISTIC_HISTORICAL_CLOCK_RECOVERY_PREFLIGHT",
        "PROTECTED_ELEVEN_FAILED_ATTEMPTS_TWO_PRE_SECRET_FAILURES_AND_SECURITY_CLOCK_DECOUPLING_RECOVERY_PREFLIGHT",
        "PROTECTED_PASS_RECEIPT_BOUND"
      ]
    },
    "delivery_status": {
      "enum": [
        "LOCAL_ONLY_NOT_PUBLISHED",
        "CONTROLLED_MAIN_DELIVERY_PENDING"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_ref"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"const": "PASS"},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "linked_final_acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {"pattern": "^AC-[0-9]{3}$"},
          "status": {"enum": ["PARTIAL", "NOT_RUN"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "production_oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAILED", "NOT_RUN"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "protected_execution_receipt": {
      "enum": [
        "machine/stages/S7/reviews/t0702/execution-receipt.json",
        "machine/stages/S7/reviews/t0703/execution-receipt.json",
        "machine/stages/S7/reviews/t0704/execution-receipt.json"
      ]
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "prohibition_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_gmail_calls",
        "gmail_mutations",
        "private_repository_calls",
        "real_secrets_read",
        "protected_key_deliveries",
        "external_writes",
        "remote_publication",
        "non_moomoo_full_reads",
        "non_moomoo_downloads",
        "non_moomoo_mutations",
        "raw_before_verification",
        "untrusted_content_execution",
        "model_real_data_calls",
        "model_secret_requests",
        "moomoo_portal_calls",
        "persistent_plaintext_objects",
        "thread_trash_calls",
        "permanent_delete_calls",
        "release_assets_above_one",
        "production_workflow_runs"
      ],
      "properties": {
        "real_gmail_calls": {"const": 0},
        "gmail_mutations": {"const": 0},
        "private_repository_calls": {"const": 0},
        "real_secrets_read": {"const": 0},
        "protected_key_deliveries": {"const": 0},
        "external_writes": {"const": 0},
        "remote_publication": {"const": 0},
        "non_moomoo_full_reads": {"const": 0},
        "non_moomoo_downloads": {"const": 0},
        "non_moomoo_mutations": {"const": 0},
        "raw_before_verification": {"const": 0},
        "untrusted_content_execution": {"const": 0},
        "model_real_data_calls": {"const": 0},
        "model_secret_requests": {"const": 0},
        "moomoo_portal_calls": {"const": 0},
        "persistent_plaintext_objects": {"const": 0},
        "thread_trash_calls": {"const": 0},
        "permanent_delete_calls": {"const": 0},
        "release_assets_above_one": {"const": 0},
        "production_workflow_runs": {"const": 0}
      }
    },
    "next_action": {"type": "string", "minLength": 1}
  }
}
