{
  "schema_version": 1,
  "secret_root": "/etc/cyberboss/credentials",
  "rules": {
    "owner": "root",
    "group": "cyberboss",
    "file_mode": "0640",
    "directory_mode": "0750",
    "values_in_repository": false,
    "values_in_environment": false,
    "log_values": false
  },
  "slots": [
    {
      "id": "github-code-token",
      "path": "/etc/cyberboss/credentials/github-code.token",
      "provider": "github",
      "purpose": "final-only MetaDatabase publication",
      "secret": true,
      "activation_status": "activation_pending"
    },
    {
      "id": "private-db-gh-login",
      "path": "/var/lib/cyberboss-data/.config/gh/hosts.yml",
      "provider": "github",
      "purpose": "Private-Database no-clone client authentication",
      "secret": true,
      "execution_identity": "cyberboss-data",
      "owner": "cyberboss-data",
      "file_mode": "0600",
      "activation_status": "activation_pending"
    },
    {
      "id": "cloudflare-access-api-token",
      "path": "/etc/cyberboss/credentials/cloudflare-access-api.token",
      "provider": "cloudflare",
      "purpose": "Access Apps and Policies Write on one existing account",
      "secret": true,
      "activation_status": "activation_pending"
    },
    {
      "id": "cloudflare-dns-api-token",
      "path": "/etc/cyberboss/credentials/cloudflare-dns-api.token",
      "provider": "cloudflare",
      "purpose": "DNS Write on linzezhang.com only",
      "secret": true,
      "activation_status": "activation_pending"
    },
    {
      "id": "cloudflare-r2-api-token",
      "path": "/etc/cyberboss/credentials/cloudflare-r2-api.token",
      "provider": "cloudflare",
      "purpose": "Workers R2 Storage Write without Access or DNS write",
      "secret": true,
      "activation_status": "activation_pending"
    },
    {
      "id": "cloudflare-account-id",
      "path": "/etc/cyberboss/credentials/cloudflare-account-id",
      "provider": "cloudflare",
      "purpose": "existing account identifier",
      "secret": false,
      "activation_status": "activation_pending"
    },
    {
      "id": "cloudflare-zone-id",
      "path": "/etc/cyberboss/credentials/cloudflare-zone-id",
      "provider": "cloudflare",
      "purpose": "linzezhang.com zone identifier",
      "secret": false,
      "activation_status": "activation_pending"
    },
    {
      "id": "cloudflare-origin-hostname",
      "path": "/etc/cyberboss/credentials/cloudflare-origin-hostname",
      "provider": "cloudflare",
      "purpose": "existing reverse-proxy origin hostname",
      "secret": false,
      "activation_status": "activation_pending"
    },
    {
      "id": "cloudflare-access-owner-identity",
      "path": "/etc/cyberboss/credentials/cloudflare-access-owner-identity",
      "provider": "cloudflare",
      "purpose": "single explicitly approved Access identity",
      "secret": true,
      "activation_status": "activation_pending"
    },
    {
      "id": "cloudflare-access-status-service-token",
      "path": "/etc/cyberboss/credentials/cloudflare-access-status-service-token",
      "provider": "cloudflare",
      "purpose": "specific status collector service-token identifier",
      "secret": true,
      "activation_status": "activation_pending"
    },
    {
      "id": "r2-access-key-id",
      "path": "/etc/cyberboss/credentials/r2-access-key-id",
      "provider": "cloudflare-r2",
      "purpose": "object data-plane access to one bucket",
      "secret": true,
      "activation_status": "activation_pending"
    },
    {
      "id": "r2-secret-access-key",
      "path": "/etc/cyberboss/credentials/r2-secret-access-key",
      "provider": "cloudflare-r2",
      "purpose": "object data-plane access to one bucket",
      "secret": true,
      "activation_status": "activation_pending"
    },
    {
      "id": "oci-config",
      "path": "/etc/cyberboss/credentials/oci-config",
      "provider": "oci",
      "purpose": "OCI SDK profile without embedded private key",
      "secret": true,
      "activation_status": "activation_pending"
    },
    {
      "id": "oci-private-key",
      "path": "/etc/cyberboss/credentials/oci-private-key",
      "provider": "oci",
      "purpose": "OCI API signing key",
      "secret": true,
      "activation_status": "activation_pending"
    },
    {
      "id": "oci-bucket-name",
      "path": "/etc/cyberboss/credentials/oci-bucket-name",
      "provider": "oci",
      "purpose": "one pre-existing private bucket",
      "secret": false,
      "activation_status": "activation_pending"
    }
  ],
  "attestations": [
    {
      "id": "cloudflare-access-scope",
      "path": "/etc/cyberboss/credentials/cloudflare-access-scope.json",
      "required_before_real_write": true
    },
    {
      "id": "cloudflare-dns-scope",
      "path": "/etc/cyberboss/credentials/cloudflare-dns-scope.json",
      "required_before_real_write": true
    },
    {
      "id": "cloudflare-r2-scope",
      "path": "/etc/cyberboss/credentials/cloudflare-r2-scope.json",
      "required_before_real_write": true
    },
    {
      "id": "oci-object-scope",
      "path": "/etc/cyberboss/credentials/oci-object-scope.json",
      "required_before_real_write": true
    }
  ]
}
