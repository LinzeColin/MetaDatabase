# Fail closed: copy to /etc/cyberboss/cyberboss.env, mode 0600 root:root.
# systemd reads it before dropping privileges; the service user cannot read the file.
# Never commit the populated file.
NODE_ENV=production
TZ=UTC
CB_PRODUCT_VERSION=0.0.0.4

# Fixed local CyberBoss source bundle must support the non-gendered `neutral` value.
CYBERBOSS_USER_NAME=Linz
CYBERBOSS_USER_GENDER=neutral

# Patch target: prefer file-based allowed IDs. Never place the populated file in Git.
CYBERBOSS_ALLOWED_USER_IDS_FILE=/etc/cyberboss/credentials/wechat-allowed-users

# Cloud paths.
CYBERBOSS_STATE_DIR=/var/lib/cyberboss
CYBERBOSS_SHARED_ROOT=/var/lib/cyberboss
CYBERBOSS_WORKSPACE_ROOT=/srv/cyberboss-workspaces
CYBERBOSS_WORKSPACE_CONFIG=/etc/cyberboss/workspaces.json

# Runtime: same-host loopback only.
CYBERBOSS_RUNTIME=codex
CYBERBOSS_CODEX_ENDPOINT=ws://127.0.0.1:8765
CYBERBOSS_CODEX_LISTEN=ws://127.0.0.1:8765
CB_CLAUDE_RUNTIME=false
CB_CLAUDE_EVAL_PASSED=false

# Application command used by run-cyberboss.sh after source reconciliation.
CB_START_COMMAND=npm run shared:start
CB_HTTP_BIND=127.0.0.1
CB_HTTP_PORT=8780

# Reliability flags.
CB_DURABLE_INBOX=true
CB_DURABLE_OUTBOX=true
CB_PRIVATE_DB_CANONICAL_SYNC=true
CB_TIMELINE_WEB=true
CB_STATUS_EXPORTER=true
CB_R2_SNAPSHOT=true
CB_OCI_BACKUP=false
CB_FILE_ATTACHMENTS=false
CB_STORE_FULL_CONTENT=false
CB_AUTONOMOUS_MUTATION=false

# Runtime state.
CB_RUNTIME_DB=/var/lib/cyberboss/runtime.db
CB_STATUS_PATH=/var/lib/cyberboss/status/snapshot.json
CB_SINGLETON_LOCK=/var/lib/cyberboss/locks/bridge.lock
CB_ACTIVE_PAYLOAD_TTL_HOURS=24
CB_JOB_CONCURRENCY=1
CB_QUEUE_LIMIT=100
CB_MAX_INPUT_BYTES=32768
CB_OUTBOX_MAX_ATTEMPTS=5
CB_CANONICAL_FLUSH_ON_TERMINAL=true
CB_CANONICAL_BATCH_MAX=50
CB_CANONICAL_BATCH_MAX_BYTES=262144

# Canonical Private-MetaDatabase no-clone client. Authentication reuses the
# dedicated service user's `gh` login state; never clone Private-Database.
CB_DATA_REPO_SLUG=LinzeColin/Private-Database
CB_DATA_AREA=Private-MetaDatabase
CB_DATA_DOMAIN=CyberBoss
CB_PRIVATE_DB_CLIENT=/opt/cyberboss-cloud/shared/private_db_client.py
CB_PRIVATE_DB_AUTH_MODE=gh-login
CB_IDENTITY_SCOPE_POLICY=/etc/cyberboss/identity-scope.policy.json
CB_CANONICAL_LAST_OBJECT_FILE=/var/lib/cyberboss/status/canonical-last-object.sha256
CB_CANONICAL_MAX_LAG_SECONDS=900

# Code identity and local-artifact deployment. PG-0..PG-5 must pass before the
# branch is pushed or a PR/tag is created.
CB_APP_REPO_SLUG=LinzeColin/MetaDatabase
CB_APP_SUBPATH=CyberBoss
CB_APP_ROOT=/opt/cyberboss-cloud
CB_INCOMING_ROOT=/var/lib/cyberboss/incoming
CB_APP_USER=cyberboss
CB_APP_GROUP=cyberboss
CB_MIGRATE_COMMAND=true

# Cold object storage through a preconfigured rclone remote. Do not embed keys here.
CB_R2_REMOTE=r2:cyberboss-cold/ovh-singapore-vps-1
CB_R2_BUCKET=cyberboss-cold
CB_R2_PREFIX=ovh-singapore-vps-1/
CB_BACKUP_LOCAL_DIR=/var/lib/cyberboss/snapshots
CB_RESTORE_ROOT=/var/lib/cyberboss/restore-tests
CB_BACKUP_INCLUDE_WECHAT_STATE=false
CB_OCI_STATE=not_configured
CB_OCI_BUCKET_FILE=/etc/cyberboss/credentials/oci-bucket-name
CB_OCI_PREFIX=cyberboss-cold-backup/ovh-singapore-vps-1/
CB_PROVIDER_ACTIVATION_CONFIG=/etc/cyberboss/provider-activation.json

# Resource profile is selected immediately from live measurements. These are safe tiny-profile defaults, not claims about the host.
CB_WARN_DISK_PERCENT=80
CB_DEGRADED_DISK_PERCENT=85
CB_STOP_DISK_PERCENT=90
CB_WARN_MEMORY_PERCENT=80
CB_DEGRADED_MEMORY_PERCENT=85
CB_STOP_MEMORY_PERCENT=92
CB_MIN_FREE_MEMORY_MB=512
CB_MAX_LOAD_1M=3.5
CB_RESOURCE_PROFILE=tiny
CB_MAX_WORKSPACE_BYTES=8589934592
CB_MAX_LOG_BYTES=314572800
CB_MAX_LOCAL_SNAPSHOT_BYTES=1073741824

# Self-heal is conservative by default.
CB_SELFHEAL_RESTART_ON_UNHEALTHY=false
CB_SELFHEAL_MAX_RESTARTS_10M=3
CB_SELFHEAL_COOLDOWN_SECONDS=120
