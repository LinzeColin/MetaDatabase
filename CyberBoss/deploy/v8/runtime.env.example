CYBERBOSS_DB_PATH=/var/lib/cyberboss/runtime.sqlite3
CYBERBOSS_PUBLIC_DIR=/opt/cyberboss-cloud/current/starter_kit/public
CYBERBOSS_LISTEN_HOST=127.0.0.1
CYBERBOSS_LISTEN_PORT=8787
CYBERBOSS_ALLOWED_HOSTS=cyberboss.linzezhang.com,localhost,127.0.0.1
CYBERBOSS_ILINK_LOGIN_BASE_URL=https://ilinkai.weixin.qq.com/
CYBERBOSS_POLICY_VERSION=privacy-v1
# 32-byte runtime keys are loaded through systemd credentials by the install adapter;
# never place real keys in this file or Git.
# Ordinary users use one Owner-funded DeepSeek API project credential loaded by systemd.
# The key itself must be stored at /etc/cyberboss/credentials/deepseek-api-key, never here.
CYBERBOSS_DEEPSEEK_MODEL=deepseek-v4-pro
CYBERBOSS_DEEPSEEK_REASONING_EFFORT=high
CYBERBOSS_DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
CYBERBOSS_DEEPSEEK_TIMEOUT_MS=300000
CYBERBOSS_ORDINARY_SEAT_LIMIT=5
CYBERBOSS_GLOBAL_DAILY_TOKEN_CAP=1000000000

