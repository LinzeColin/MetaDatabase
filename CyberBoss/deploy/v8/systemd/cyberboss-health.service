[Unit]
Description=CyberBoss deterministic health snapshot
After=cyberboss.service

[Service]
Type=oneshot
User=cyberboss
Group=cyberboss
EnvironmentFile=/etc/cyberboss/runtime.env
ExecStart=/opt/cyberboss-cloud/current/scripts/status.sh --write-snapshot
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/cyberboss /var/lib/cyberboss
