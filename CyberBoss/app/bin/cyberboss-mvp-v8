#!/usr/bin/env node
'use strict';
const path=require('node:path');const fs=require('node:fs');
const {createMvpComponents}=require('../src/runtime/create-mvp-components');
const dbPath=process.env.CYBERBOSS_DB_PATH||'/var/lib/cyberboss/runtime.sqlite3';
const assetRoot=process.env.CYBERBOSS_PUBLIC_DIR||path.join(__dirname,'../public');
if(!fs.existsSync(dbPath))throw Object.assign(new Error('CYBERBOSS_DB_NOT_INITIALIZED'),{code:'CYBERBOSS_DB_NOT_INITIALIZED'});
const app=createMvpComponents({dbPath,assetRoot});
const host=process.env.CYBERBOSS_LISTEN_HOST||'127.0.0.1';const port=Number(process.env.CYBERBOSS_LISTEN_PORT||8787);
app.runtime.start({host,port}).then(x=>console.log(JSON.stringify({event:'cyberboss_started',...x,version:'v0.0.0.8'}))).catch(e=>{console.error(JSON.stringify({event:'startup_failed',code:e?.code||'STARTUP_FAILED'}));process.exit(1);});
async function shutdown(signal){console.log(JSON.stringify({event:'shutdown',signal}));await app.close();process.exit(0);}process.on('SIGTERM',()=>shutdown('SIGTERM'));process.on('SIGINT',()=>shutdown('SIGINT'));
