[Unit]
Description=CyberBoss isolated R2 restore drill for %i
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/cyberboss-cloud/current/app/scripts/cb530-cloud-backup.js

[Service]
Type=oneshot
User=cyberboss
Group=cyberboss
Environment=HOME=/var/lib/cyberboss
Environment=PATH=/opt/cyberboss-cloud/shared/toolchains/bin:/usr/bin:/bin
Environment=CB_RELEASE_ROOT=/opt/cyberboss-cloud/current
EnvironmentFile=/etc/cyberboss/cyberboss.env
LoadCredential=r2_account_id:/etc/cyberboss/credentials/r2_account_id
LoadCredential=r2_oauth_refresh_token:/etc/cyberboss/credentials/r2_oauth_refresh_token
Environment=CB_R2_ACCOUNT_ID_FILE=%d/r2_account_id
Environment=CB_R2_OAUTH_REFRESH_TOKEN_FILE=%d/r2_oauth_refresh_token
Environment=CB_R2_OAUTH_STATE_DIR=/var/lib/cyberboss/credentials
Environment=CB_R2_TOKEN_FILE=/run/cyberboss-r2-oauth/r2_api_token
RuntimeDirectory=cyberboss-r2-oauth
RuntimeDirectoryMode=0700
ExecStartPre=/opt/cyberboss-cloud/shared/toolchains/bin/node /opt/cyberboss-cloud/current/ops/systemd/cb530-refresh-r2-oauth.js
ExecStart=/opt/cyberboss-cloud/shared/toolchains/bin/node /opt/cyberboss-cloud/current/app/scripts/cb530-cloud-backup.js restore --backup-id %i
UMask=0077
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/cyberboss
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
