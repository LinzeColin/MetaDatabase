[Unit]
Description=Serenity daily analysis - 10 Beijing slots on business days (08:30-17:30)

[Timer]
# 原设计的 R1..R10：北京时间工作日 08:30 到 17:30，每小时半点。
OnCalendar=Mon..Fri *-*-* 08,09,10,11,12,13,14,15,16,17:30:00 Asia/Shanghai
AccuracySec=1s
# 关机/重启错过的时点开机后补一次（服务内部只补“最近 3 小时内未跑的时段”，过期的不补）。
Persistent=true
Unit=serenity-tick.service

[Install]
WantedBy=timers.target
