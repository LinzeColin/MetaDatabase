# 阅迁账户平台 v0.0.0.1.9。复制到 /etc/weread-port/platform.env，权限必须为 0600。
NODE_ENV=production
WRP_PUBLIC_BASE_URL=https://weread.linzezhang.com
# 当前生产范围只开放 weread.linzezhang.com；管理域与跨域 Cookie 必须保持关闭。
WRP_ADMIN_BASE_URL=
WRP_ADMIN_ACCOUNT_IDS=
WRP_SERVICE_HOST=127.0.0.1
WRP_SERVICE_PORT=8788
# 仅用于 Coolify Traefik → 本机回环账户服务的 Docker 私网桥接。
# 不能写 0.0.0.0、公网 IP 或回环地址；生产现网固定为 Coolify 网桥网关。
WRP_EDGE_BRIDGE_HOST=
WRP_EDGE_BRIDGE_PORT=8789
WRP_DATABASE_PATH=/var/lib/weread-port/platform.sqlite3
WRP_OBJECT_STORE_MODE=r2

# 部署身份：COMMIT.py 完成后由最后一公里脚本写入，不得留空或写浮动分支。
WRP_TASKPACK_VERSION=v0.0.0.1.9
WRP_RELEASE_COMMIT=
WRP_OVH_RELEASE_ID=
WRP_EDGE_DEPLOYMENT_ID=

# 必填 Secret。不得提交到 Git、任务包、日志或命令行历史。
WRP_SESSION_PEPPER=
WRP_CREDENTIAL_PEPPER=
WRP_KEYRING_JSON=
WRP_ACTIVE_KEY_ID=k1
WRP_INTERNAL_PROXY_SECRET=

# Cloudflare R2：命名空间职责固定，不能互换。
WRP_R2_ENDPOINT=
WRP_R2_BUCKET=
WRP_R2_ACCESS_KEY_ID=
WRP_R2_SECRET_ACCESS_KEY=
WRP_R2_REGION=auto
WRP_PRIMARY_OBJECT_PREFIX=primary-objects
WRP_PRIVATE_DATABASE_BACKUP_PREFIX=backups/private-database

# OAuth/OIDC。Google 登录和 Drive 读取使用分离授权范围。
WRP_GOOGLE_CLIENT_ID=
WRP_GOOGLE_CLIENT_SECRET=
WRP_GITHUB_CLIENT_ID=
WRP_GITHUB_CLIENT_SECRET=
WRP_NOTION_CLIENT_ID=
WRP_NOTION_CLIENT_SECRET=

# Private-Database：必须调用 KMOS 的 canonical clone-free REST 客户端；禁止 clone 或伪造 Git 工作树。
WRP_PRIVATE_DATABASE_CLIENT_PATH=/opt/weread-port/private-db-client/private_db_client.py
WRP_PRIVATE_DATABASE_CLIENT_SHA256=
WRP_PRIVATE_DATABASE_AREA=Private-MetaDatabase
WRP_PRIVATE_DATABASE_DOMAIN=WeReadPort
WRP_PRIVATE_DATABASE_GH_TOKEN=
WRP_PRIVATE_DATABASE_R2_BACKUP_TARGET=

# R2 → OCI 异地冷备；凭据由既有 rclone 配置持有。
WRP_R2_RCLONE_SOURCE=
WRP_OCI_RCLONE_TARGET=

WRP_SESSION_TTL_SECONDS=2592000
WRP_RECENT_AUTH_SECONDS=900
WRP_OAUTH_TTL_SECONDS=600
WRP_MAX_JSON_BYTES=2097152
WRP_MAX_IMPORT_BYTES=52428800
WRP_MAX_IMPORT_ITEMS=500
# 每个账户处于 PENDING/RUNNING 的导入任务上限，防止单一租户耗尽公共 worker。
WRP_MAX_ACTIVE_IMPORT_JOBS_PER_ACCOUNT=6
WRP_MAX_WEREAD_BOOKS=2000
WRP_UPSTREAM_TIMEOUT_MS=15000
WRP_UPSTREAM_RETRY_ATTEMPTS=2
WRP_READINESS_CACHE_SECONDS=30
WRP_AUTH_FAILURE_LIMIT=8
WRP_AUTH_FAILURE_WINDOW_SECONDS=900
WRP_AUTH_LOCK_SECONDS=900
WRP_IMPORT_LEASE_SECONDS=300
WRP_WORKER_STALE_SECONDS=30
WRP_OBJECT_HEALTH_PROBE_PREFIX=_system/readiness
