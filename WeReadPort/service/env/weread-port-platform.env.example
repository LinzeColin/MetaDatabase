# 阅迁账户平台 v0.0.0.1.8。复制到 /etc/weread-port/platform.env，权限必须为 0600。
NODE_ENV=production
WRP_PUBLIC_BASE_URL=https://weread-port.linzezhang35.chatgpt.site
WRP_SERVICE_HOST=127.0.0.1
WRP_SERVICE_PORT=8788
WRP_DATABASE_PATH=/var/lib/weread-port/platform.sqlite3
WRP_OBJECT_STORE_MODE=r2

# 必填 Secret。安装器可生成本地随机值，但不得提交到 Git。
WRP_SESSION_PEPPER=
WRP_CREDENTIAL_PEPPER=
WRP_KEYRING_JSON=
WRP_ACTIVE_KEY_ID=k1
WRP_INTERNAL_PROXY_SECRET=

# Cloudflare R2：用户正文、导入内容和账户对象的加密长期存储。
WRP_R2_ENDPOINT=
WRP_R2_BUCKET=
WRP_R2_ACCESS_KEY_ID=
WRP_R2_SECRET_ACCESS_KEY=
WRP_R2_REGION=auto

# OAuth/OIDC。Google 同时覆盖 Gmail 账户登录与 Google Drive 导入。
WRP_GOOGLE_CLIENT_ID=
WRP_GOOGLE_CLIENT_SECRET=
WRP_GITHUB_CLIENT_ID=
WRP_GITHUB_CLIENT_SECRET=
WRP_NOTION_CLIENT_ID=
WRP_NOTION_CLIENT_SECRET=

# Private-Database：仅写入脱敏结构化完成态事实和对象引用，不写用户正文或真实凭据。
WRP_PRIVATE_DATABASE_WORKTREE=
WRP_PRIVATE_DATABASE_BRANCH=main
WRP_PRIVATE_DATABASE_FACTS_PATH=systems/weread-port

# R2 → OCI 异地冷备。由现有 rclone 配置提供凭据；不在本文件保存明文密码。
WRP_R2_RCLONE_SOURCE=
WRP_OCI_RCLONE_TARGET=

# 有界资源与会话。
WRP_SESSION_TTL_SECONDS=2592000
WRP_RECENT_AUTH_SECONDS=900
WRP_OAUTH_TTL_SECONDS=600
WRP_MAX_JSON_BYTES=2097152
WRP_MAX_IMPORT_BYTES=52428800
WRP_MAX_IMPORT_ITEMS=500
WRP_MAX_WEREAD_BOOKS=2000

# 有界上游、认证防爆破、导入租约与真实就绪检查。
WRP_UPSTREAM_TIMEOUT_MS=15000
WRP_UPSTREAM_RETRY_ATTEMPTS=2
WRP_READINESS_CACHE_SECONDS=30
WRP_AUTH_FAILURE_LIMIT=8
WRP_AUTH_FAILURE_WINDOW_SECONDS=900
WRP_AUTH_LOCK_SECONDS=900
WRP_IMPORT_LEASE_SECONDS=300
WRP_WORKER_STALE_SECONDS=30
WRP_OBJECT_HEALTH_PROBE_PREFIX=_system/readiness
