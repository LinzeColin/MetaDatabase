[Unit]
Description=把阅迁 R2 加密用户对象镜像到 OCI 异地冷备
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=weread-port
Group=weread-port
EnvironmentFile=/etc/weread-port/platform.env
WorkingDirectory=/opt/weread-port/current
ExecStart=/usr/bin/python3 service/scripts/platform_ops.py r2-to-oci
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
TimeoutStartSec=3600
