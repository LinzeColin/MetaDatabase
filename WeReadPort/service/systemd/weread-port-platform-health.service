[Unit]
Description=即时检查阅迁账户平台并执行有界自愈
After=weread-port-platform.service

[Service]
Type=oneshot
# 仅重置并重启 SELF_HEAL_UNITS；数据完整性失败不会自动恢复数据。
User=root
Group=root
EnvironmentFile=/etc/weread-port/platform.env
WorkingDirectory=/opt/weread-port/current
# 保持长期运行服务对状态目录的所有权，root 只拥有重启权限。
ExecStartPre=/usr/bin/install -d -o weread-port -g weread-port -m 0700 /var/lib/weread-port
ExecStart=/usr/bin/python3 service/scripts/platform_ops.py health
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/weread-port
UMask=0077
TimeoutStartSec=45
