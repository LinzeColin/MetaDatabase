[Unit]
Description=创建阅迁 SQLite 一致性快照并验证恢复
After=weread-port-platform.service

[Service]
Type=oneshot
User=weread-port
Group=weread-port
EnvironmentFile=/etc/weread-port/platform.env
WorkingDirectory=/opt/weread-port/current
ExecStart=/usr/bin/python3 service/scripts/platform_ops.py backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/weread-port
UMask=0077
TimeoutStartSec=300
