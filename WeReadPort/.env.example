# ChatGPT Sites / Worker（真实值仅配置在平台 Secret，不提交）
WEREAD_ACCOUNT_SERVICE_URL=https://weread-api.linzezhang.com
WRP_INTERNAL_PROXY_SECRET=

# OVH 账户服务：复制 service/env/weread-port-platform.env.example 后由 Owner 在 0600 文件中填入真实值。
# 不在仓库、任务包、CI、命令行参数或日志中保存任何真实 Secret。
NODE_ENV=production
WRP_PUBLIC_BASE_URL=https://weread-port.linzezhang35.chatgpt.site
WRP_SERVICE_HOST=127.0.0.1
WRP_SERVICE_PORT=8788
WRP_DATABASE_PATH=/var/lib/weread-port/platform.sqlite3
WRP_OBJECT_STORE_MODE=r2
WRP_PRIVATE_DATABASE_WORKTREE=/srv/private-database
WRP_PRIVATE_DATABASE_BRANCH=main
WRP_PRIVATE_DATABASE_FACTS_PATH=systems/weread-port
