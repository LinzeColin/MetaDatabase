[Unit]
Description=自愈并采集微信读书笔记迁移站点健康与官方技能版本
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=weread-port-ops
Group=weread-port-ops
EnvironmentFile=-/etc/weread-port/ops.env
WorkingDirectory=/opt/weread-port-ops/current
ExecStart=/opt/weread-port-ops/current/bin/weread-port-ops reconcile
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
StateDirectory=weread-port-ops
ReadWritePaths=/var/lib/weread-port-ops
UMask=0077
TimeoutStartSec=60
