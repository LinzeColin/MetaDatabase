#!/usr/bin/env bash
set -euo pipefail
TARGET_VERSION="${1:?用法：rollback <已安装版本>}"
[[ "$TARGET_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "版本格式无效" >&2; exit 2; }
TARGET="/opt/weread-port-ops/releases/$TARGET_VERSION"
[[ -d "$TARGET" ]] || { echo "未找到已安装版本： $TARGET" >&2; exit 2; }
sudo ln -sfn "releases/$TARGET_VERSION" /opt/weread-port-ops/current
sudo systemctl daemon-reload
sudo systemctl restart weread-port-ops-monitor.service
/opt/weread-port-ops/current/bin/weread-port-ops diagnose
