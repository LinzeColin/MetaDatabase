# ChatGPT Sites 公共生产地址。首次部署后立即填写。
WEREAD_PORT_SITE_URL=

# 仅保存短期、可重建的运行状态。严禁保存用户密钥、个人内容、书名、搜索词和导出压缩包。
WEREAD_PORT_STATE_DIR=/var/lib/weread-port-ops
WEREAD_PORT_DB_PATH=/var/lib/weread-port-ops/runtime.sqlite3
WEREAD_PORT_STATUS_PATH=/var/lib/weread-port-ops/public-status.json
WEREAD_PORT_RETENTION_HOURS=72
WEREAD_PORT_HTTP_TIMEOUT_SECONDS=10
WEREAD_PORT_OFFICIAL_SKILL_URL=https://raw.githubusercontent.com/Tencent/WeChatReading/main/skills/SKILL.md

# 复用现有 MetaDatabase 客户端；不得克隆 Private-Database。
WEREAD_PORT_PRIVATE_DB_CLIENT=
WEREAD_PORT_PRIVATE_DB_AREA=Private-MetaDatabase
WEREAD_PORT_PRIVATE_DB_RELROOT=operations/weread-port

# 真实值只能写入 root 所有、权限为 0600 的文件，或现有密钥管理器。
# 备份语义：本地 SQLite 只保留短期可重建快照；R2 加密保存 GitHub Private-Database 权威事实库冷备；OCI 镜像 R2。
GH_TOKEN=
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WEREAD_PORT_R2_REMOTE=
WEREAD_PORT_OCI_REMOTE=
RCLONE_CONFIG=
