    },
    "disclosures": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "events": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "evidence": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "gates": {
      "type": "object"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "locale": {
      "pattern": "^zh",
      "type": "string"
    },
    "market_capability": {
      "type": "object"
    },
    "scenarios": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
