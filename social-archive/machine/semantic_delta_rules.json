{
  "schema_version": "2.0",
  "classifications": [
    "satisfied",
    "apply",
    "adapt",
    "equivalent",
    "conflict",
    "blocked",
    "obsolete"
  ],
  "default_decision": "preserve upstream and adapt",
  "controlled_rebuild_trigger": [
    "transaction core absent",
    "focused core/migration tests fail"
  ],
  "reprepare_threshold": "architecture/permission/data/cost/scope/acceptance semantic change >30%"
}
