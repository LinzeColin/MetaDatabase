# grep '^social-archive/'  bash scripts/reclaim_our_superseded_images.sh <当前版本号>
# grep '^social-archive/'  四道自锁，缺一不删
# grep '^social-archive/'  ① 只动 social-archive/ 开头的仓库名——别的项目一概不碰
# grep '^social-archive/'  ② 跳过当前版本
# grep '^social-archive/'  ③ 跳过 rollback / rollback-candidate
# grep '^social-archive/'  ④ 跳过任何被容器引用的镜像 ID（**含已停止的容器**）
 grep '^social-archive/' | grep '^social-archive/' | while read -r ref; do
 grep '^social-archive/'   tag="${ref##*:}"
 grep '^social-archive/'   # ②③
 grep '^social-archive/'   case "$tag" in
 grep '^social-archive/'     "$current"|rollback|rollback-candidate|'<none>') continue ;;
 grep '^social-archive/'   esac
 grep '^social-archive/'   id="$(sudo docker image inspect -f '{{.Id}}' "$ref" 2>/dev/null || true)"
 grep '^social-archive/'   [ -n "$id" ] || continue
 grep '^social-archive/'   case "$keep" in
 grep '^social-archive/'     *"$id"*) printf '    留着 %s（有容器或回滚点在引用）\n' "$ref"; continue ;;
 grep '^social-archive/'   esac
 grep '^social-archive/'   printf '    回收 %s\n' "$ref"
 grep '^social-archive/'   sudo docker rmi "$ref" >/dev/null 2>&1 \
 grep '^social-archive/'     || printf '    收不掉 %s（跳过，不因此失败）\n' "$ref"
 grep '^social-archive/' done
