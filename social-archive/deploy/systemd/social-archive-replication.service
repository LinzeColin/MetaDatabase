[Unit]
Description=Replicate Social Archive objects to R2 then GitHub Release
After=social-archive.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=socialarchive
Group=socialarchive
WorkingDirectory=/opt/social-archive
EnvironmentFile=/etc/social-archive/social-archive.env
LoadCredential=r2_access_key_id:/opt/social-archive/runtime/secrets/r2_access_key_id
LoadCredential=r2_secret_access_key:/opt/social-archive/runtime/secrets/r2_secret_access_key
# **必须用有私有仓权限的那个 token。** 实测（2026-08-04）：
# runtime/secrets/github_token 只看得见公开仓——用它查 Private-Database
# 直接报 not resolvable，于是第三份副本（GitHub Release）永远失败，
# 而错误信息说的是「私有归档仓验证失败」，听起来像仓库不对。
# Core 容器拿到的一直是另一个（compose 把 github_markdown_token 映射进去），
# 只有这条 systemd 路径漏了。
LoadCredential=github_token:/opt/social-archive/runtime/secrets/github_markdown_token
Environment=SOCIAL_ARCHIVE_R2_ACCESS_KEY_ID_FILE=%d/r2_access_key_id
Environment=SOCIAL_ARCHIVE_R2_SECRET_ACCESS_KEY_FILE=%d/r2_secret_access_key
Environment=SOCIAL_ARCHIVE_GITHUB_TOKEN_FILE=%d/github_token
ExecStart=/opt/social-archive/.venv/bin/python /opt/social-archive/scripts/replicate_objects.py --store all --limit 200
ExecStart=/opt/social-archive/.venv/bin/python /opt/social-archive/scripts/github_release_backup.py --upload
# **索引快照已经拆成独立单元 social-archive-runtime-db-backup.service**（2026-09-30）：
# 它原来是这里的第三条 ExecStart，前面的 replicate_objects.py 因 OCI 失败 exit 4 之后就永远轮不到，
# 运行库快照因此 25 天没做。OCI 也已退役——这里只复制到 R2，再把 R2 已验证的密文放进 GitHub Release。
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/social-archive
