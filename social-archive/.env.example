# Social Archive v0.0.0.6 — non-secret deployment configuration.
SOCIAL_ARCHIVE_ENV=production
SOCIAL_ARCHIVE_HOST=0.0.0.0
SOCIAL_ARCHIVE_PORT=8765
# The Core keeps port 8765 inside its container. These two ports are the
# host-only loopback bindings used by OVH systemd, probes and Cloudflare Tunnel.
# They deliberately avoid the existing production services on 8765/8780.
SOCIAL_ARCHIVE_CORE_LOOPBACK_PORT=18765
SOCIAL_ARCHIVE_STATUS_PORT=18780
SOCIAL_ARCHIVE_PUBLIC_BASE_URL=https://social-archive-api.linzezhang.com
SOCIAL_ARCHIVE_PUBLIC_LIBRARY_URL=https://social-archive.linzezhang.com
SOCIAL_ARCHIVE_DATA_ROOT=/var/lib/social-archive
SOCIAL_ARCHIVE_RUNTIME_DB=/var/lib/social-archive/runtime/social-archive.sqlite3
SOCIAL_ARCHIVE_STAGING_ROOT=/var/lib/social-archive/staging
# Core mounts this host path at DATA_ROOT. Local installs use the project
# runtime directory; systemd production must set /var/lib/social-archive.
SOCIAL_ARCHIVE_DATA_HOST_PATH=./runtime/data
# In production, import and CLI output must remain beneath the same host data
# root: /var/lib/social-archive/import and /var/lib/social-archive/vendor-output.
# The CLI sidecar is uid 10002; set this production value to `id -g socialarchive`
# so it can write the setgid shared data root without receiving any replica secret.
# 写共享数据根（vendor-output 等）用的组 = `id -g socialarchive`
SOCIAL_ARCHIVE_HOST_DATA_GID=980
# 读 /run/secrets/ 用的组 = `getent group socialarchive-secrets`
# **和上面不是同一个组。** 只配上面那个，CLI Sidecar 会读不到自己的密钥：
# /health 仍然 200、业务路由一律 401、界面永远「同步中」（C-T00-01）。
SOCIAL_ARCHIVE_HOST_SECRETS_GID=10001
# Private-Database is API-only. Never mount, clone, or configure a local checkout.
SOCIAL_ARCHIVE_PRIVATE_DB_CLIENT=/opt/kmos/KMDatabase/machine/tools/private_db_client.py
SOCIAL_ARCHIVE_PRIVATE_DATABASE_AREA=Private-MetaDatabase
SOCIAL_ARCHIVE_PRIVATE_DATABASE_REPOSITORY=LinzeColin/Private-Database
SOCIAL_ARCHIVE_PRIVATE_DATABASE_BRANCH=main
SOCIAL_ARCHIVE_PWA_ROOT=/app/apps/pwa
SOCIAL_ARCHIVE_WATCH_ROOT=/var/lib/social-archive/import
SOCIAL_ARCHIVE_EXPORT_ROOT=/var/lib/social-archive/exports
SOCIAL_ARCHIVE_VENDOR_OUTPUT_ROOT=/var/lib/social-archive/vendor-output
SOCIAL_ARCHIVE_VENDOR_OUTPUT_HOST_PATH=./runtime/vendor-output
SOCIAL_ARCHIVE_PRIVATE_DATABASE_HOST_PATH=./runtime/private-database-spool
SOCIAL_ARCHIVE_IMPORT_HOST_PATH=./runtime/import
SOCIAL_ARCHIVE_LOG_LEVEL=INFO

# Free-only and archive defaults.
SOCIAL_ARCHIVE_PAID_API_ALLOWED=false
SOCIAL_ARCHIVE_L2_ENABLED=false
SOCIAL_ARCHIVE_L3_ENABLED=true
SOCIAL_ARCHIVE_R2_SOFT_GIB=8
SOCIAL_ARCHIVE_R2_HARD_GIB=9.25
SOCIAL_ARCHIVE_OCI_SOFT_GIB=16
SOCIAL_ARCHIVE_OCI_HARD_GIB=19
SOCIAL_ARCHIVE_GITHUB_RELEASE_SOFT_GIB=8
SOCIAL_ARCHIVE_GITHUB_RELEASE_HARD_GIB=9.25
SOCIAL_ARCHIVE_MAX_DOWNLOAD_MIB=1800
SOCIAL_ARCHIVE_WORKER_POLL_SECONDS=2

# Isolated workers; disabled until source lock and health/canary gates pass.
SOCIAL_ARCHIVE_XHS_WORKER_URL=http://xhs-worker:5556
SOCIAL_ARCHIVE_DOUK_WORKER_URL=http://douk-worker:5555
SOCIAL_ARCHIVE_KS_WORKER_URL=http://ks-worker:5557
SOCIAL_ARCHIVE_CLI_WORKER_URL=http://cli-tools:5560
SOCIAL_ARCHIVE_CLI_OUTPUT_ROOT=/var/lib/social-archive/vendor-output/cli

# Secret references. Values live in 0600 files and are never committed.
SOCIAL_ARCHIVE_PAIRING_REQUIRED=true
# 登录（v0.0.0.7 / T02）。client_id 不是机密，可以留在这里；
# secret 只走 runtime/secrets 文件，永不进 .env。
# client_id 不是机密，直接写在这里；没有它登录路由会返回 503。
SOCIAL_ARCHIVE_GOOGLE_CLIENT_ID=
SOCIAL_ARCHIVE_GITHUB_CLIENT_ID=
SOCIAL_ARCHIVE_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_oauth_client_secret
SOCIAL_ARCHIVE_GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_oauth_client_secret
# 凭据托管（v0.0.0.7 / T05）。与备份那对 age 密钥**分开**——
# 备份私钥仅在恢复演练时读取，不进容器。
SOCIAL_ARCHIVE_CREDENTIAL_AGE_IDENTITY_FILE=/run/secrets/credential_age_identity
# 上一行那把私钥对应的公钥。公钥不是机密，直接写这里。
# 两个都要——只配文件不配收件人，加密会 503，而错误信息只说「未配置」，
# 不会告诉你缺的是哪一半。
SOCIAL_ARCHIVE_CREDENTIAL_AGE_RECIPIENT=
# The private library UI trusts Cloudflare Access; the extension API still requires its bearer token.
SOCIAL_ARCHIVE_TRUST_CLOUDFLARE_ACCESS=true
SOCIAL_ARCHIVE_API_TOKEN_FILE=/run/secrets/social_archive_api_token
SOCIAL_ARCHIVE_CLI_WORKER_TOKEN_FILE=/run/secrets/cli_worker_token
SOCIAL_ARCHIVE_AGE_RECIPIENT=
SOCIAL_ARCHIVE_AGE_IDENTITY_FILE=

# Cloudflare R2 and OCI S3-compatible endpoints.
SOCIAL_ARCHIVE_R2_ENDPOINT=
SOCIAL_ARCHIVE_R2_BUCKET=
SOCIAL_ARCHIVE_R2_ACCESS_KEY_ID_FILE=/run/secrets/r2_access_key_id
SOCIAL_ARCHIVE_R2_SECRET_ACCESS_KEY_FILE=/run/secrets/r2_secret_access_key
SOCIAL_ARCHIVE_OCI_ENDPOINT=
SOCIAL_ARCHIVE_OCI_BUCKET=
SOCIAL_ARCHIVE_OCI_ACCESS_KEY_ID_FILE=/run/secrets/oci_access_key_id
SOCIAL_ARCHIVE_OCI_SECRET_ACCESS_KEY_FILE=/run/secrets/oci_secret_access_key

# Structured facts, Markdown, and encrypted GitHub Release assets.
SOCIAL_ARCHIVE_GITHUB_MARKDOWN_REPOSITORY=LinzeColin/Private-Database
SOCIAL_ARCHIVE_GITHUB_ARCHIVE_REPOSITORY=LinzeColin/Private-Database
SOCIAL_ARCHIVE_GITHUB_MARKDOWN_BRANCH=main
SOCIAL_ARCHIVE_GITHUB_TOKEN_FILE=/run/secrets/github_token
# This is a separate Private-Database-scoped credential.  It is injected only
# into the clone-free facts-sync systemd unit and never into Core or the Vault
# release path.
SOCIAL_ARCHIVE_PRIVATE_DB_TOKEN_FILE=/run/secrets/private_database_token

# 西方三源的账号扫描身份（v0.0.0.7）。
#
# **这一整段此前不存在。** registry.py 一直在读这六个变量，而 .env.example、
# compose、部署脚本、文档里一处都没有——于是 Owner 部署好、登录好、账号也连上了，
# X / Reddit / Instagram 的服务端同步仍然一条都取不到，**而没有任何东西告诉他
# 还差什么**。由 scripts/find_settings_with_no_way_to_set_them.py 抓出。
#
# 身份（下面三个）现在**默认取你连接的那个账号**，只有形状不对或还没连账号时
# 才回落到这里。留空是正常的，填了是覆盖。
SOCIAL_ARCHIVE_X_USER_ID=
SOCIAL_ARCHIVE_REDDIT_USERNAME=
SOCIAL_ARCHIVE_INSTAGRAM_USERNAME=
# Reddit 要求每个客户端自报一个可识别的 User-Agent，否则会被限流。
SOCIAL_ARCHIVE_REDDIT_USER_AGENT=SocialArchive/0.0.0.29
# 这两个 token 文件由 install.sh 建成空占位；空值走的是「尚未授权」那一支，
# 有中文说明，不会被当成"没配也能跑"。
SOCIAL_ARCHIVE_X_OAUTH_TOKEN_FILE=/run/secrets/x_oauth_token
SOCIAL_ARCHIVE_REDDIT_OAUTH_TOKEN_FILE=/run/secrets/reddit_oauth_token

# Optional free destination connectors.
SOCIAL_ARCHIVE_NOTION_API_VERSION=2026-03-11
SOCIAL_ARCHIVE_NOTION_DATA_SOURCE_ID=
SOCIAL_ARCHIVE_NOTION_DATABASE_ID=
SOCIAL_ARCHIVE_NOTION_TOKEN_FILE=/run/secrets/notion_token
SOCIAL_ARCHIVE_OBSIDIAN_VAULT_ROOT=
SOCIAL_ARCHIVE_OBSIDIAN_REST_URL=
SOCIAL_ARCHIVE_OBSIDIAN_REST_TOKEN_FILE=/run/secrets/obsidian_rest_token
SOCIAL_ARCHIVE_OBSIDIAN_REST_CA_FILE=

# Optional mature reader projections. The core remains authoritative.
SOCIAL_ARCHIVE_KARAKEEP_URL=http://karakeep:3000
SOCIAL_ARCHIVE_KARAKEEP_TOKEN_FILE=/run/secrets/karakeep_api_token
SOCIAL_ARCHIVE_LINKWARDEN_URL=http://linkwarden:3000
SOCIAL_ARCHIVE_LINKWARDEN_TOKEN_FILE=/run/secrets/linkwarden_api_token
