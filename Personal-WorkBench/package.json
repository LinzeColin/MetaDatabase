{
  "name": "huchuliang-workbench-sites",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:ui-structure",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "check": "npm run lint && npm run typecheck && node scripts/check-project.mjs && npm run verify:assets",
    "verify:assets": "node scripts/verify-assets.mjs",
    "test:ui-structure": "npm run build && node --import ./tests/register-cloudflare-workers-loader.mjs --test tests/ui-structure.test.mjs && node --import ./tests/register-cloudflare-workers-loader.mjs scripts/record-ui-structure.mjs",
    "test:visual": "node scripts/test-visual.mjs",
    "db:generate": "drizzle-kit generate",
    "db:verify": "node scripts/verify-schema.mjs",
    "test:schema": "node --test tests/schema.test.mjs",
    "test:auth": "node scripts/verify-auth-contract.mjs && node --experimental-strip-types --test tests/auth-contract.test.mts",
    "test:auth-saved": "node scripts/verify-saved-auth.mjs",
    "test:auth-runtime": "node scripts/probe-local-auth-runtime.mjs",
    "test:tenant": "node scripts/verify-tenant-contract.mjs && node --test tests/tenant-isolation.test.mjs",
    "test:api": "node --test tests/api-contract.test.mjs",
    "test:r2": "node scripts/verify-r2-contract.mjs && node --experimental-strip-types --test tests/r2.test.mts",
    "test:s2": "npm run db:verify && npm run test:schema && npm run test:auth && npm run test:auth-saved && npm run test:tenant && npm run test:api && npm run test:r2"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pngjs": "^7.0.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
