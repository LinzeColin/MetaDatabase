{
  "name": "mydairy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:ui-structure",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "check": "npm run lint && npm run typecheck && node scripts/check-project.mjs && npm run verify:assets",
    "verify:assets": "node scripts/verify-assets.mjs",
    "test:ui-structure": "npm run build && node --import ./tests/register-cloudflare-workers-loader.mjs --test tests/ui-structure.test.mjs && node --experimental-strip-types --test tests/canonical-domain.test.mts && node --import ./tests/register-cloudflare-workers-loader.mjs scripts/record-ui-structure.mjs",
    "test:visual": "node scripts/test-visual.mjs",
    "test:legacy-import": "node --import ./tests/register-cloudflare-workers-loader.mjs --experimental-strip-types --test tests/legacy-import.test.mts",
    "test:modules": "node --test tests/module-matrix.test.mjs",
    "test:workbench-data": "node --experimental-strip-types --test tests/account-return-path.test.mts tests/visitor-time.test.mts tests/local-record-cache.test.mts && node --test tests/workbench-persistence-ui.test.mjs tests/legacy-domain-handoff-ui.test.mjs",
    "test:e2e": "node --import ./tests/register-cloudflare-workers-loader.mjs --test tests/e2e-smoke.test.mjs",
    "test:privacy": "node --import ./tests/register-cloudflare-workers-loader.mjs --experimental-strip-types --test tests/privacy.test.mts",
    "test:account-lifecycle": "node --import ./tests/register-cloudflare-workers-loader.mjs --experimental-strip-types --test tests/account-lifecycle.test.mts",
    "db:generate": "drizzle-kit generate",
    "db:verify": "node scripts/verify-schema.mjs",
    "test:schema": "node --test tests/schema.test.mjs",
    "test:unit": "npm run db:verify && npm run test:schema && npm run test:auth && npm run test:tenant && npm run test:api && npm run test:r2",
    "test:auth": "node scripts/verify-auth-contract.mjs && node --import ./tests/register-cloudflare-workers-loader.mjs --experimental-strip-types --test tests/auth-contract.test.mts tests/mail-port.test.mts tests/auth-tenant-integration.test.mts tests/legacy-domain-handoff.test.mts",
    "test:auth-saved": "node scripts/verify-saved-auth.mjs",
    "test:auth-runtime": "node --import ./tests/register-cloudflare-workers-loader.mjs --experimental-strip-types scripts/probe-local-auth-runtime.mjs",
    "test:owner-activation": "node --test tests/owner-activation-evidence.test.mjs",
    "test:asset-rights": "node --test tests/asset-rights.test.mjs",
    "test:public-launch-preflight": "node --test tests/public-launch-preflight.test.mjs",
    "test:release-evidence": "node --test tests/release-evidence.test.mjs tests/preflight-evidence.test.mjs",
    "test:acceptance-sequence": "node --test tests/acceptance-sequence-addendum.test.mjs",
    "test:tenant": "node scripts/verify-tenant-contract.mjs && node --test tests/tenant-isolation.test.mjs && node --import ./tests/register-cloudflare-workers-loader.mjs --experimental-strip-types --test tests/tenant-store-integration.test.mts",
    "test:quality": "node scripts/verify-quality.mjs",
    "test:resilience": "node --experimental-strip-types scripts/verify-offline-replay.mts",
    "test:api": "node --test tests/api-contract.test.mjs && node --experimental-strip-types --test tests/storage-binding-health.test.mts",
    "test:r2": "node scripts/verify-r2-contract.mjs && node --import ./tests/register-cloudflare-workers-loader.mjs --experimental-strip-types --test tests/r2.test.mts",
    "test:recovery": "npm run test:resilience",
    "test:regression": "npm run test:modules && npm run test:workbench-data && npm run test:e2e",
    "verify:release": "node scripts/verify-release.mjs",
    "test:production-smoke": "npm run verify:production-smoke",
    "verify:production-smoke": "node scripts/verify-production-smoke.mjs",
    "verify:public-launch": "node scripts/verify-public-launch-preflight.mjs",
    "verify:owner-activation": "node scripts/verify-owner-activation.mjs",
    "verify:ops-projection": "node scripts/verify-ops-projection.mjs",
    "verify:source-projection": "node scripts/verify-source-projection.mjs",
    "validate:acceptance-sequence": "node scripts/validate-acceptance-sequence-addendum.mjs",
    "test:s2": "npm run db:verify && npm run test:schema && npm run test:auth && npm run test:auth-saved && npm run test:tenant && npm run test:api && npm run test:r2"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pngjs": "^7.0.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
