{
  "name": "personal-workbench",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern 13_evidence --ignore-pattern vps3-taskpack-evidence",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "npm run test:core",
    "test:core": "node --test tests/module-matrix.test.mjs tests/workbench-persistence-ui.test.mjs && node --experimental-strip-types --test tests/account-entry-state.test.mts tests/account-return-path.test.mts tests/auth-return-recovery.test.mts tests/visitor-time.test.mts tests/local-record-cache.test.mts tests/request-timeout.test.mts",
    "test:contracts": "node --test tests/api-contract.test.mjs tests/legacy-domain-handoff-ui.test.mjs tests/ops-projection-contract.test.mjs",
    "test:runtime": "node --experimental-strip-types --test tests/vps3/postgres-adapter.test.mts tests/vps3/local-object-store.test.mts tests/vps3/brand-contract.test.mjs",
    "check:release": "npm run lint && npm run typecheck && npm run test:core && npm run test:contracts && npm run test:runtime && npm run build",
    "dev:vps3": "next dev",
    "build:vps3": "next build",
    "start:vps3": "next start -H 0.0.0.0 -p 3000",
    "db:migrate:vps3": "node scripts/vps3/migrate-runtime.mjs",
    "db:backup:vps3": "node scripts/vps3/backup-runtime.mjs",
    "db:restore:vps3": "bash scripts/vps3/restore-runtime.sh",
    "db:import-sqlite:vps3": "node scripts/vps3/import-sqlite-to-postgres.mjs",
    "accept:vps3": "PWB_PRODUCTION_ACCEPTANCE=1 playwright test -c playwright.vps3.config.ts",
    "accept:vps3:public": "playwright test -c playwright.vps3.config.ts",
    "accept:vps3:pre-redeploy": "PWB_PRODUCTION_ACCEPTANCE=1 PWB_ACCEPTANCE_PHASE=pre-redeploy playwright test -c playwright.vps3.config.ts",
    "accept:vps3:post-redeploy": "PWB_PRODUCTION_ACCEPTANCE=1 PWB_ACCEPTANCE_PHASE=post-redeploy playwright test -c playwright.vps3.config.ts",
    "check:vps3": "npm run check:release"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "better-sqlite3": "12.11.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pngjs": "7.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
