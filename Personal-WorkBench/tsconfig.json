{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "tests/pw-temp.spec.ts",
    "tests/auth-tenant-integration.test.mts",
    "tests/legacy-domain-handoff.test.mts",
    "tests/canonical-domain.test.mts",
    "tests/tenant-store-integration.test.mts",
    "tests/legacy-import.test.mts",
    "tests/account-lifecycle.test.mts",
    "tests/privacy.test.mts",
    "tests/storage-binding-health.test.mts",
    "tests/r2.test.mts"
  ]
}
