# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM dependencies AS builder
WORKDIR /app
ARG APP_ORIGIN=https://mydairy.linzezhang.com
ENV NEXT_TELEMETRY_DISABLED=1 \
    APP_ORIGIN=${APP_ORIGIN} \
    DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    OBJECT_STORAGE_PATH=/data/objects \
    RUNTIME_BACKUP_DIR=/data/backups \
    WORKBENCH_REQUIRE_SENSITIVE_CONSENT=0
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl postgresql-client \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /data/objects /data/backups \
 && chown -R node:node /data /app
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/drizzle/postgres ./drizzle/postgres
COPY --from=builder --chown=node:node /app/scripts/vps3 ./scripts/vps3
# The pre-cutover SQLite importer is an operational script rather than a traced
# Next.js dependency, so retain its native module and its two runtime helpers.
COPY --from=dependencies --chown=node:node /app/node_modules/better-sqlite3 ./node_modules/better-sqlite3
COPY --from=dependencies --chown=node:node /app/node_modules/bindings ./node_modules/bindings
COPY --from=dependencies --chown=node:node /app/node_modules/file-uri-to-path ./node_modules/file-uri-to-path
USER node
EXPOSE 3000
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(async r=>{const v=await r.json();process.exit(r.ok&&v.ready===true?0:1)}).catch(()=>process.exit(1))"
CMD ["node", "scripts/vps3/entrypoint.mjs"]
