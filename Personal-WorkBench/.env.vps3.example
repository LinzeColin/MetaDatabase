# Copy this file to .env.vps3, replace every placeholder, and keep the copy
# private. Docker's build context excludes all .env files. Every Compose command
# must include: --env-file .env.vps3

# Canonical public origin; use a complete origin without a trailing slash.
APP_ORIGIN=https://mydairy.linzezhang.com
# Optional comma-separated first-party migration origins. Leave empty for only
# APP_ORIGIN.
APP_TRUSTED_ORIGINS=

# PostgreSQL service settings. POSTGRES_PASSWORD is interpolated into the
# runtime connection URL, so use a long URL-safe secret (letters, digits,
# hyphen, underscore) rather than raw URL punctuation.
POSTGRES_DB=personal_workbench
POSTGRES_USER=personal_workbench
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_URL_SAFE_DATABASE_PASSWORD

# Authentication and approved public providers.
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
MAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
AUTH_FROM_EMAIL=REPLACE_WITH_A_VERIFIED_SENDER_EMAIL
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# Public privacy contact shown by the account page.
LEGAL_OPERATOR_NAME=REPLACE_WITH_OPERATOR_NAME
PRIVACY_CONTACT_EMAIL=REPLACE_WITH_PRIVACY_CONTACT_EMAIL
