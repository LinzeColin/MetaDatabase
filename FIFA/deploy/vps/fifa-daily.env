# FIFA 日报在服务器上的配置。装到 /etc/fifa-daily/fifa-daily.env（install.sh 会装）。
# 只放非机密参数；Gatus 心跳令牌单独放在 /etc/fifa-daily/gatus.token（root:fifa-daily 0640，不入仓）。

# ---- 代码来源（公开仓，匿名拉取；脚本拒绝带 @ 的地址）----
REPO_URL=https://github.com/LinzeColin/MetaDatabase.git
BRANCH=main
SUBDIR=FIFA/daily-research      # 只有这个子目录的内容变了才会更新代码

# ---- 目录 ----
BASE=/opt/fifa-daily            # 代码发布(releases/) + Python 虚拟环境(venvs/) + 拉取状态(pull/)；current -> releases/<子树哈希>
DATA=/var/lib/fifa-daily        # 站点发布(releases/)；current -> releases/<时间戳>，只读挂给 nginx；状态(ledger/runs 等)随站点一起版本化

# ---- 行为 ----
RUN_TIMEOUT=900                 # 一次生成的上限（秒）
TEST_TIMEOUT=600                # 更新代码前离线测试的上限（秒）
PIP_TIMEOUT=900                 # 建虚拟环境的上限（秒）
KEEP_SITES=4                    # 保留最近几份站点发布（含线上这份）
KEEP_CODE=2                     # 保留最近几份代码发布（含线上这份）

# ---- 对外与监控 ----
PUBLIC_URL=https://home.linzezhang.com/fifa/
# Gatus 外部端点心跳：每次运行结束推一次成败；30 小时没有推送 Gatus 自己判红（= 页面「报告过期」口径）。留空则不推。
GATUS_URL=https://uptime.linzezhang.com
GATUS_KEY=fifa_fifa-daily-freshness          # = 分组_名称，对应 Gatus 配置里 external-endpoints 的 group: fifa / name: fifa-daily-freshness（分组用 ASCII：非 ASCII 的键 Gatus 推送接口找不到）
