      "action": {
        "action_id": "LOGICAL_DISABLE_ADVICE_AND_REQUEST_FRESHNESS_AUDIT",
        "mode": "AUTOMATIC_LOGICAL",
        "logical_effect": "NO_RECOMMENDATION_NO_ORDER",
        "owner_review_required": true
      }
    },
    {
      "id": "HP-SILENT-COVERAGE-GAP",
      "domain": "COVERAGE",
      "signal": "silent_coverage_gap_count",
      "operator": "GREATER_THAN",
      "threshold_ref": "silent_coverage_gap_max",
      "source_path": "machine/facts/canonical_facts.json#truth_and_evidence.silent_coverage_gap_target",
      "action": {
        "action_id": "LOGICAL_DISABLE_ADVICE_AND_REQUEST_COVERAGE_AUDIT",
        "mode": "AUTOMATIC_LOGICAL",
        "logical_effect": "NO_RECOMMENDATION_NO_ORDER",
        "owner_review_required": true
      }
    },
    {
      "id": "HP-MODEL-PSI-STOP",
      "domain": "MODEL_DRIFT",
