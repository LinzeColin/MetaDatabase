      "action": {
        "action_id": "LOGICAL_KEEP_EMAIL_AND_REQUEST_VERIFICATION_REVIEW",
        "mode": "AUTOMATIC_LOGICAL",
        "logical_effect": "NO_RECOMMENDATION_NO_ORDER",
        "owner_review_required": true
      }
    },
    {
      "id": "HP-EVIDENCE-INTEGRITY",
      "domain": "EVIDENCE",
      "signal": "evidence_integrity_status",
      "operator": "NOT_EQUAL",
      "threshold_ref": "PASS",
      "source_path": "machine/facts/canonical_facts.json#truth_and_evidence",
      "action": {
        "action_id": "LOGICAL_QUARANTINE_DERIVED_EVIDENCE_AND_REQUEST_INTEGRITY_AUDIT",
        "mode": "AUTOMATIC_LOGICAL",
        "logical_effect": "NO_RECOMMENDATION_NO_ORDER",
        "owner_review_required": true
