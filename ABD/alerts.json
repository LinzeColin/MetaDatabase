        "logical_effect": "NO_RECOMMENDATION_NO_ORDER",
        "owner_review_required": true
      }
    },
    {
      "id": "HP-RESOURCE-ENVELOPE",
      "domain": "RESOURCE",
      "signal": "resource_envelope_status",
      "operator": "NOT_EQUAL",
      "threshold_ref": "ENVELOPE_PASS",
      "source_path": "machine/evidence/EVD-S04-P04.json#production_capacity_verified",
      "action": {
        "action_id": "LOGICAL_HOLD_CANDIDATE_AND_REQUEST_CAPACITY_REVIEW",
        "mode": "MANUAL_LOGICAL",
        "logical_effect": "NO_RECOMMENDATION_NO_ORDER",
        "owner_review_required": true
      }
    },
    {
      "id": "HP-EMAIL-VERIFICATION",
