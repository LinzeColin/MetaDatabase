      "action": {
        "action_id": "LOGICAL_QUARANTINE_DIAGNOSTIC_INPUT_AND_REQUEST_REPLAY",
        "mode": "MANUAL_LOGICAL",
        "logical_effect": "NO_RECOMMENDATION_NO_ORDER",
        "owner_review_required": true
      }
