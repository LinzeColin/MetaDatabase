FROM docker.io/library/python:3.12-alpine@sha256:aa679aa4eed6eb56c1dc6ad3f1b98b7d2d788fd961596779d188fdedad97fb38

LABEL org.opencontainers.image.title="ABD observation runtime"
LABEL org.opencontainers.image.version="0.0.0.1"
LABEL org.opencontainers.image.description="Non-trading, non-recommendation ABD runtime control plane"

WORKDIR /app

RUN addgroup -S -g 10001 abd && adduser -S -D -H -u 10001 -G abd abd

COPY --chown=abd:abd ABD/runtime/abd_runtime /app/abd_runtime
COPY --chown=abd:abd ABD/runtime/observation_config.json /etc/abd/config.json

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ABD_CONFIG_FILE=/etc/abd/config.json \
    ABD_RUNTIME_MODE=OBSERVATION_ONLY

USER 10001:10001
EXPOSE 8080

ENTRYPOINT ["python3", "-m", "abd_runtime.server"]
