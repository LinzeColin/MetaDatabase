FROM docker.io/library/python:3.12-alpine@sha256:aa679aa4eed6eb56c1dc6ad3f1b98b7d2d788fd961596779d188fdedad97fb38

LABEL org.opencontainers.image.title="ABD observation runtime"
LABEL org.opencontainers.image.version="0.0.0.1"
LABEL org.opencontainers.image.description="Non-trading, non-recommendation ABD runtime control plane"

WORKDIR /app

RUN apk add --no-cache curl \
    && addgroup -S -g 10001 abd \
    && adduser -S -D -H -u 10001 -G abd abd

COPY --chown=abd:abd ABD/runtime/abd_runtime /app/abd_runtime
COPY --chown=abd:abd ABD/runtime/observation_config.json /etc/abd/config.json

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ABD_CONFIG_FILE=/etc/abd/config.json \
    ABD_RUNTIME_MODE=OBSERVATION_ONLY

USER 10001:10001
EXPOSE 8080

HEALTHCHECK --interval=60s --timeout=5s --start-period=15s --retries=3 \
  CMD python3 -c 'import json,urllib.request; opener=urllib.request.build_opener(urllib.request.ProxyHandler({})); state=json.load(opener.open("http://127.0.0.1:8080/healthz",timeout=3)); expected={"service":"ABD","version":"0.0.0.1","mode":"OBSERVATION_ONLY","decision":"NO_RECOMMENDATION_NO_ORDER","ready":True,"recommendation_enabled":False,"order_submission_enabled":False,"market_or_account_connected":False,"gmail_or_tab_connected":False}; raise SystemExit(0 if all(state.get(key)==value for key,value in expected.items()) else 1)'

ENTRYPOINT ["python3", "-m", "abd_runtime.server"]
