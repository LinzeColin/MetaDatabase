[Unit]
Description=ABD observation runtime limited self-heal watchdog
Documentation=https://github.com/LinzeColin/MetaDatabase/tree/main/ABD
Wants=docker.service
After=docker.service
Requires=docker.service
ConditionPathExists=/usr/bin/docker

[Service]
Type=oneshot
UMask=0077
RuntimeDirectory=abd-v0001-observation-watchdog
RuntimeDirectoryMode=0700
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/sh /usr/local/lib/abd/abd-v0001-observation-watchdog.sh
TimeoutStartSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/abd-v0001-observation-watchdog /run/docker.sock
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
