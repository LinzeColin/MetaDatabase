{
  "schema_version": "1.0.0",
  "policy_id": "S14-P02-SECRET-POLICY",
  "contract_id": "AC-S14-P02",
  "requirement_id": "REQ-S14-P02",
  "stage_id": "S14",
  "phase_id": "P02",
  "product_version": "0.0.0.1",
  "fixed_clock": "2026-08-09T00:00:00+10:00",
  "execution_mode": "FROZEN_LOCAL_DETERMINISTIC_NO_NETWORK",
  "scan_targets": [
    "abd_acceptance/threat_model.py",
    "abd_acceptance/security_analysis.py",
    "security_pipeline.yml",
    "sast_policy.json",
    "secret_policy.json",
    "infra/compose.yml",
    "infra/config.schema.json",
    "infra/cloudflared.yml",
    "infra/rebuild.sh",
    "infra/systemd/abd.service",
    "infra/systemd/abd-cloudflared.service",
    "pyproject.toml",
    "uv.lock"
  ],
  "detection_rules": [
    {
      "id": "SECRET-AWS-ACCESS-KEY",
      "severity": "CRITICAL",
      "mode": "LITERAL_VALUE_PATTERN"
    },
    {
      "id": "SECRET-PRIVATE-KEY",
      "severity": "CRITICAL",
      "mode": "LITERAL_VALUE_PATTERN"
    },
    {
      "id": "SECRET-GITHUB-PERSONAL-TOKEN",
      "severity": "HIGH",
      "mode": "LITERAL_VALUE_PATTERN"
    },
    {
      "id": "SECRET-GENERIC-INLINE-ASSIGNMENT",
      "severity": "HIGH",
      "mode": "LITERAL_VALUE_PATTERN"
    }
  ],
  "allowed_reference_tokens": [
    "ABD_RUNTIME_SECRET_FILE",
    "ABD_CONFIG_FILE",
    "credentials-file"
  ],
  "prohibited_repository_extensions": [
    ".env",
    ".pem",
    ".key",
    ".p12"
  ],
  "finding_gate": {
    "unresolved_critical": 0,
    "unresolved_high": 0,
    "automatic_waiver_allowed": false
  },
  "external_effect_boundary": {
    "external_network_accessed": false,
    "gmail_account_or_api_accessed": false,
    "ovh_or_cloudflare_runtime_accessed": false,
    "real_account_balance_read_or_written": false,
    "recommendation_generated_or_enabled": false,
    "order_submitted_confirmed_or_retried": false,
    "production_deployed_or_activated": false,
    "real_time_soak_waited": false,
    "incremental_cash_spent_aud": "0.00"
  },
  "not_production_evidence": true
}
