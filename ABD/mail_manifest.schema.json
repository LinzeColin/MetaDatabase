{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abd.invalid/schema/mail_manifest.schema.json",
  "title": "ABD S06/P02 Mail Preservation Manifest",
  "description": "Private-plane immutable manifest for one raw Gmail message and every fetched attachment. This schema never authorizes a Gmail trash action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "contract_id",
    "requirement_id",
    "product_version",
    "archive_layout_version",
    "status",
    "gmail_message_id",
    "source_history_id",
    "received_at_utc",
    "private_storage",
    "raw_eml",
    "headers",
    "attachments",
    "readback_verified",
    "trash_action",
    "gmail_mutation_performed",
    "real_time_soak_wait_required",
    "archive_root_reference",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^MAN-S06-P02-[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "contract_id": {"const": "AC-S06-P02"},
    "requirement_id": {"const": "REQ-S06-P02"},
    "product_version": {"const": "0.0.0.1"},
    "archive_layout_version": {"const": "1.0.0"},
    "status": {"const": "PRESERVED_PENDING_S06_P03_AND_P04"},
    "gmail_message_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "source_history_id": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,38})$"},
    "received_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "private_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "domain", "repository_raw_data_write", "private_db_client_execution_in_p02"],
      "properties": {
        "area": {"const": "Private-MetaDatabase"},
        "domain": {"const": "ABD"},
        "repository_raw_data_write": {"const": "PROHIBITED"},
        "private_db_client_execution_in_p02": {"const": false}
      }
    },
    "raw_eml": {"$ref": "#/$defs/file"},
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "count"],
      "properties": {
        "path": {"const": "headers.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/attachment"}
    },
    "readback_verified": {"const": true},
    "trash_action": {"const": "KEEP_PENDING_SECURITY_AND_TRASH_GATES"},
    "gmail_mutation_performed": {"const": false},
    "real_time_soak_wait_required": {"const": false},
    "archive_root_reference": {"type": "string", "pattern": "^records/[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"const": "raw.eml"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment_id", "archive_key", "filename", "path", "sha256", "size_bytes"],
      "properties": {
        "attachment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
        "archive_key": {"$ref": "#/$defs/sha256"},
        "filename": {"type": "string", "minLength": 1, "maxLength": 255},
        "path": {"type": "string", "pattern": "^attachments/[A-Za-z0-9][A-Za-z0-9_-]{0,127}\\.bin$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
