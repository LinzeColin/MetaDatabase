{
  "manifest_version": 3,
  "name": "x2n 内容库",
  "version": "0.0.0.1",
  "description": "保存你明确选择的当前内容，并在本机整理为知识资产。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 x2n 内容库"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
