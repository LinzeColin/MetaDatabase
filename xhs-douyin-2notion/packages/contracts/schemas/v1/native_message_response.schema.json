{
  "$defs": {
    "BilibiliSelectedCollectionCapabilityOutcome": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "feature_flag": {
          "$ref": "#/$defs/CapabilityFeatureFlag"
        },
        "platform": {
          "const": "bilibili",
          "title": "Platform",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/CapabilityReasonCode"
        },
        "relation": {
          "const": "saved_current",
          "title": "Relation",
          "type": "string"
        },
        "scope_id": {
          "const": "bilibili_selected_collection",
          "title": "Scope Id",
          "type": "string"
        },
        "source_registry_digests": {
          "$ref": "#/$defs/SourceRegistryDigests"
        },
        "terminal": {
          "$ref": "#/$defs/CapabilityTerminal"
        }
      },
      "required": [
        "terminal",
        "reason_code",
        "source_registry_digests",
        "feature_flag",
        "evidence_hash",
        "evaluated_at",
        "scope_id",
        "platform",
        "relation"
      ],
      "title": "BilibiliSelectedCollectionCapabilityOutcome",
      "type": "object"
    },
    "CapabilityFeatureFlag": {
      "description": "The capability contract never claims that a live platform is enabled.",
      "enum": [
        "ci_synthetic_only",
        "disabled",
        "mvp_activation_candidate"
      ],
      "title": "CapabilityFeatureFlag",
      "type": "string"
    },
    "CapabilityManifest": {
      "additionalProperties": false,
      "properties": {
        "capability_contract_version": {
          "const": "1.0",
          "title": "Capability Contract Version",
          "type": "string"
        },
        "outcomes": {
          "items": {
            "discriminator": {
              "mapping": {
                "bilibili_selected_collection": "#/$defs/BilibiliSelectedCollectionCapabilityOutcome",
                "douyin_favorites": "#/$defs/DouyinFavoritesCapabilityOutcome",
                "douyin_likes": "#/$defs/DouyinLikesCapabilityOutcome",
                "kuaishou_selected_collection": "#/$defs/KuaishouSelectedCollectionCapabilityOutcome",
                "taobao_selected_collection": "#/$defs/TaobaoSelectedCollectionCapabilityOutcome",
                "weibo_selected_collection": "#/$defs/WeiboSelectedCollectionCapabilityOutcome",
                "xiaohongshu_favorites": "#/$defs/XiaohongshuFavoritesCapabilityOutcome",
                "xiaohongshu_likes": "#/$defs/XiaohongshuLikesCapabilityOutcome"
              },
              "propertyName": "scope_id"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/XiaohongshuFavoritesCapabilityOutcome"
              },
              {
                "$ref": "#/$defs/XiaohongshuLikesCapabilityOutcome"
              },
              {
                "$ref": "#/$defs/DouyinFavoritesCapabilityOutcome"
              },
              {
                "$ref": "#/$defs/DouyinLikesCapabilityOutcome"
              },
              {
                "$ref": "#/$defs/BilibiliSelectedCollectionCapabilityOutcome"
              },
              {
                "$ref": "#/$defs/KuaishouSelectedCollectionCapabilityOutcome"
              },
              {
                "$ref": "#/$defs/WeiboSelectedCollectionCapabilityOutcome"
              },
              {
                "$ref": "#/$defs/TaobaoSelectedCollectionCapabilityOutcome"
              }
            ]
          },
          "title": "Outcomes",
          "type": "array"
        }
      },
      "required": [
        "capability_contract_version",
        "outcomes"
      ],
      "title": "CapabilityManifest",
      "type": "object"
    },
    "CapabilityReasonCode": {
      "description": "Reason codes are intentionally coarse and free of account/platform secrets.",
      "enum": [
        "CI_SYNTH_READY",
        "UNKNOWN_DISABLED",
        "BLOCKED_POLICY",
        "BLOCKED_AUTH",
        "BLOCKED_BUDGET",
        "BLOCKED_CAPABILITY",
        "BLOCKED_TECHNICAL"
      ],
      "title": "CapabilityReasonCode",
      "type": "string"
    },
    "CapabilityTerminal": {
      "enum": [
        "READY_FOR_MVP_ACTIVATION",
        "DISABLED_EXTERNAL_GATE"
      ],
      "title": "CapabilityTerminal",
      "type": "string"
    },
    "DataEffect": {
      "enum": [
        "none",
        "canonical_unchanged",
        "derived_output_missing",
        "unknown_fail_closed"
      ],
      "title": "DataEffect",
      "type": "string"
    },
