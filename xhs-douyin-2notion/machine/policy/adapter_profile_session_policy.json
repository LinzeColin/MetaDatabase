{
  "schema_version": "1.0",
  "policy_id": "POLICY.X2N.ADAPTER-RUNTIME.001",
  "task_id": "TSK.x2n.adapters.001",
  "default": "deny",
  "runtime": {
    "root_ref": "X2N_DATA_ROOT",
    "profile_root_ref": "X2N_DATA_ROOT/runtime/browser_profiles/<platform>",
    "profile_mode": "0700",
    "checkpoint_mode": "0600",
    "repository_profile_files_allowed": 0,
    "ordinary_backup_includes_profiles": false
  },
  "profile_launcher": {
    "browser_executable_selection": "fixed_os_candidates_only",
    "caller_supplied_executable": false,
    "caller_supplied_profile_path": false,
    "caller_supplied_url": false,
    "initial_page": "chrome_internal_new_tab",
    "explicit_confirmation": "MANUAL_LOGIN_ONLY_NO_AUTOMATION",
    "automated_login": false,
    "remote_debugging": false,
    "cookie_or_credential_input": false,
    "cookie_or_credential_export": false,
    "verification_bypass": false
  },
  "session_health": {
    "source": "live_adapter_probe_classification_only",
    "credential_or_cookie_read": false,
    "persisted_fields": [
      "platform",
      "signal",
      "observed_at"
    ],
    "ttl_seconds": 300,
    "future_clock_skew_seconds": 30,
    "signals": {
      "authenticated": "ok",
      "login_required": "blocked_user_action",
      "expired": "blocked_user_action",
      "verification_required": "blocked_user_action_no_bypass",
      "platform_changed": "blocked_platform"
    },
    "missing_or_stale": "blocked_user_action",
    "account_identity_persisted": false,
    "profile_path_emitted": false
  },
  "doctor": {
    "states": [
      "ok",
      "degraded",
      "blocked"
    ],
    "components": [
      "extension",
      "native_host",
      "companion",
      "canonical_db",
      "ffmpeg",
      "provider",
      "notion",
      "adapter"
    ],
    "core_blocking_components": [
      "native_host",
      "companion",
      "canonical_db"
    ],
    "noncore_missing_preserves_canonical": true,
    "remediation_must_be_minimal_and_executable": true,
    "sensitive_or_private_path_output": false
  },
  "adapter_execution": {
    "mutex_scope": "all_platform_adapters",
    "max_concurrent_adapters": 1,
    "mutex_wait": false,
    "minimum_batch_start_interval_seconds": 30,
    "minimum_item_observation_interval_seconds": 3,
    "automatic_scroll": false,
    "automatic_retry_on_auth_verification_or_platform_change": false,
    "rate_limit_action": "stop_platform_and_honor_later_retry",
    "rate_state_contains_profile_or_session_material": false
  },
  "batch_deletion_protection": {
    "non_authoritative_outcomes": [
      "auth_expired",
      "http_error",
      "platform_changed",
      "empty_response",
      "partial_scan"
    ],
    "removed_count_for_non_authoritative_outcome": 0,
    "complete_successes_required_for_candidate": 2,
    "maximum_automatic_state": "tombstone_candidate",
    "owner_confirmation_required_for_physical_delete": true,
    "automatic_content_delete": false
  },
  "fallback": {
    "batch_flags_default": false,
    "current_page_capture_preserved": true
  },
  "execution_evidence": {
    "owner_profile_login": "NOT_RUN",
    "real_account_execution": "NOT_RUN",
    "platform_calls": 0,
    "owner_canary": "NOT_RUN"
  }
}
