{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:x2n:stage-6-assurance-001-state:1.0",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "stage",
    "task_id",
    "phase",
    "run_id",
    "task_base_commit",
    "status",
    "acceptance_status",
    "execution",
    "next_task",
    "release_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"const": "x2n"},
    "stage": {"const": "STG.X2N.6"},
    "task_id": {"const": "TSK.x2n.assurance.001"},
    "phase": {"const": "PH.X2N.6.1"},
    "run_id": {"const": "RUN-X2N-S06-A001"},
    "task_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"const": "PASS_CI_SYNTH_CURRENT_SOFTWARE_ASSURANCE_REAL_MVP_NOT_RUN"},
    "acceptance_status": {"type": "object", "minProperties": 4, "maxProperties": 4},
    "execution": {"type": "object"},
    "next_task": {"type": "object"},
    "release_policy": {"type": "object"}
  },
  "additionalProperties": false
}
