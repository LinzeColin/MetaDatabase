{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:x2n:stage-4-review-state:1.0",
  "title": "x2n Stage 4 G4 independent review state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "stage",
    "review_id",
    "run_id",
    "review_base_commit",
    "gate",
    "task_receipts",
    "execution",
    "authorization",
    "next_task",
    "release_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"const": "x2n"},
    "stage": {"const": "STG.X2N.4"},
    "review_id": {"const": "STG.X2N.4.REVIEW"},
    "run_id": {"const": "RUN-X2N-S04-REVIEW"},
    "review_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "decision", "pass_conditions"],
      "properties": {
        "id": {"const": "G4"},
        "status": {"const": "PASS_CI_SYNTH"},
        "decision": {"const": "PASS"},
        "pass_conditions": {"type": "object", "additionalProperties": false}
      }
    },
    "task_receipts": {"type": "object", "additionalProperties": false},
    "execution": {"type": "object", "additionalProperties": false},
    "authorization": {"type": "object", "additionalProperties": false},
    "next_task": {"type": "object", "additionalProperties": false},
    "release_policy": {"type": "object", "additionalProperties": false}
  }
}
