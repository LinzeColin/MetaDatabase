{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:x2n:stage-5-review-state:1.0",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "stage",
    "review_id",
    "run_id",
    "review_base_commit",
    "gate",
    "task_receipts",
    "execution",
    "authorization",
    "next_task",
    "release_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"const": "x2n"},
    "stage": {"const": "STG.X2N.5"},
    "review_id": {"const": "STG.X2N.5.REVIEW"},
    "run_id": {"const": "RUN-X2N-S05-REVIEW"},
    "review_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gate": {"type": "object"},
    "task_receipts": {"type": "object", "minProperties": 5, "maxProperties": 5},
    "execution": {"type": "object"},
    "authorization": {"type": "object"},
    "next_task": {"type": "object"},
    "release_policy": {"type": "object"}
  },
  "additionalProperties": false
}
