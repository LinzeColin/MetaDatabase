{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:x2n:owner-mvp-release-input:1.0",
  "title": "x2n private direct-MVP release input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "release_version",
    "owner_authorization",
    "owner_input_contract_sha256",
    "owner_private_manifests",
    "enabled_scopes",
    "disabled_external_scopes",
    "douyin_sidecar",
    "model_mode",
    "rollback_target"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"const": "xhs-douyin-2notion"},
    "release_version": {"const": "v0.0.0.1"},
    "owner_authorization": {"const": "owner_authorized_direct_mvp"},
    "owner_input_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "owner_private_manifests": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_id", "content_id_sha256"],
        "properties": {
          "scope_id": {
            "enum": ["xiaohongshu_current_content", "xiaohongshu_current_content_second_batch", "douyin_favorites", "douyin_likes"]
          },
          "content_id_sha256": {
            "type": "array",
            "minItems": 20,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "enabled_scopes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_id", "max_items", "transport"],
        "properties": {
          "scope_id": {
            "enum": ["xiaohongshu_current_content", "xiaohongshu_current_content_second_batch", "douyin_favorites", "douyin_likes"]
          },
          "max_items": {"const": 20},
          "transport": {"enum": ["chrome_visible_dom", "owner_private_loopback_sidecar"]}
        }
      }
    },
    "disabled_external_scopes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_id", "reason_code", "flag_off", "platform_calls", "live_support_claim"],
        "properties": {
          "scope_id": {
            "enum": [
              "bilibili_selected_collection",
              "kuaishou_selected_collection",
              "weibo_selected_collection",
              "taobao_selected_collection"
            ]
          },
          "reason_code": {
            "enum": ["UNKNOWN_DISABLED", "BLOCKED_POLICY", "BLOCKED_AUTH", "BLOCKED_BUDGET", "BLOCKED_CAPABILITY"]
          },
          "flag_off": {"const": true},
          "platform_calls": {"const": 0},
          "live_support_claim": {"const": false}
        }
      }
    },
    "douyin_sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "attestation"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "executable_sha256",
            "resolved_lock_sha256",
            "transitive_license_report_sha256",
            "sbom_sha256"
          ],
          "properties": {
            "scope": {"const": "owner_private_build"},
            "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "resolved_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "transitive_license_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "sbom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "model_mode": {"enum": ["disabled", "suggestion_only"]},
    "rollback_target": {"const": "previous_stable_or_disable"}
  }
}
